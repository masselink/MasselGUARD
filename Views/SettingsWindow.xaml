<Window x:Class="MasselGUARD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [SettingsTitle], Source={x:Static local:Lang.Instance}}"
        Width="700" Height="680"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        Opacity="{DynamicResource Theme.WindowOpacity}"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="{Binding [SettingsTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="&#x2715;" Style="{StaticResource DangerBtn}"
                            HorizontalAlignment="Right"
                            Padding="10,4" Margin="0,0,8,0"
                            BorderThickness="0" Background="Transparent"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Tab body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,12,0,0">
                            <!-- Grouped sidebar: application-wide settings first (General, Startup, then the
                                 cross-cutting tabs), a FEATURES group for the per-feature tabs (which grey
                                 out when the feature is off). x:Names + internal Tags stay stable so the
                                 code-behind (ShowTab, ApplyPresetLocks, populate) keeps working. -->
                            <Button x:Name="TabBtnGeneral"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="General"
                                    Content="{Binding [SettingsTabGeneral],       Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnStartup"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Startup"
                                    Content="{Binding [SettingsTabStartup], Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnAppearance"    Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Appearance"
                                    Content="{Binding [SettingsTabAppearance],    Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnNotifications" Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Notifications"
                                    Content="{Binding [SettingsTabNotifHistory], Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnDiagnostics"   Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Diagnostics"
                                    Content="{Binding [SettingsTabDiagnostics],   Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnAbout"         Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="About"
                                    Content="{Binding [SettingsTabAbout],         Source={x:Static local:Lang.Instance}}"/>

                            <!-- Feature settings - greyed when the feature is disabled in General -->
                            <TextBlock Text="{Binding [SettingsSidebarFeatures], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="16,14,0,4"/>
                            <Border Height="1" Background="{DynamicResource BorderColor}" Margin="12,0,12,4"/>
                            <Button x:Name="TabBtnTunnels"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Tunnels">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M12 2 L20 5 L20 11 C20 16 16.4 19.6 12 21 C7.6 19.6 4 16 4 11 L4 5 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="WireGuard" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnDns"           Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Dns">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                                            <Ellipse Width="10" Height="20" Canvas.Left="7" Canvas.Top="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                                            <Line X1="2" Y1="12" X2="22" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
                                            <Line X1="4" Y1="6.5" X2="20" Y2="6.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                            <Line X1="4" Y1="17.5" X2="20" Y2="17.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding [SettingsTabDns], Source={x:Static local:Lang.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnWifi"          Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Wifi">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="10.6" Canvas.Top="1" Width="2.8" Height="2.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Rectangle Canvas.Left="11.2" Canvas.Top="3" Width="1.6" Height="3.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="F0 M6,6.5 h12 a3,3 0 0 1 3,3 v6.5 a3,3 0 0 1 -3,3 h-12 a3,3 0 0 1 -3,-3 v-6.5 a3,3 0 0 1 3,-3 z M7.9,11 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0 z M13.1,11 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0 z M9,15.1 h6 v1.7 h-6 z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding [SettingsTabAutomation], Source={x:Static local:Lang.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnLog"           Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Log">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M4 6 H20 M4 12 H20 M4 18 H20"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding [FeatLogTitle], Source={x:Static local:Lang.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnHistory"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="History">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M3 13 H7 V21 H3 Z M10 8 H14 V21 H10 Z M17 3 H21 V21 H17 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding [WizHistoryTitle], Source={x:Static local:Lang.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Wizard button pinned at bottom of sidebar -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                            <Button Style="{StaticResource SideTabBtn}" Click="RunWizard_Click"
                                    Content="{Binding [WizardRunAgain], Source={x:Static local:Lang.Instance}}"
                                    Padding="12,12" TextBlock.Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab pages -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <!-- Own adorner layer so lock badges track + clip with the scrolling content -->
                  <AdornerDecorator>
                    <StackPanel Margin="20,16,20,16">

                        <!-- Managed-preset banner (shown on all tabs when a policy is active) -->
                        <Border x:Name="ManagedBanner" Visibility="Collapsed"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.CornerRadius}"
                                Padding="12,8" Margin="0,0,0,14">
                            <TextBlock x:Name="ManagedBannerText"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                       Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ══ GENERAL PAGE ══════════════════════════════════ -->
                        <StackPanel x:Name="PageGeneral">

                            <!-- Language (top of General) -->
                            <TextBlock Text="{Binding [SettingsSectionLanguage], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsLanguageLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LanguagePicker"
                                              MinWidth="160" FontSize="11" Padding="6,4"
                                              SelectionChanged="LanguagePicker_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding FlagImage}"
                                                           Width="20" Height="14"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           SnapsToDevicePixels="True"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding [SettingsLanguageResetHint], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                       Margin="2,-12,0,16"/>

                            <!-- ══ FEATURES ══ Unified home for the five feature areas. Each: enable/disable,
                                 the top-bar button's behaviour (show/hide vs disable), and whether the button
                                 shows. The feature-specific tabs hold only the extra settings for each. -->
                            <TextBlock Text="{Binding [SettingsSectionFeatures], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding [SettingsFeaturesIntro], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- WireGuard -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WireGuard" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [FeatWgDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [SettingsFeatureEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatWgEnableToggle" Tag="wg" Style="{StaticResource ToggleSwitch}"
                                                          Width="44" Height="22" VerticalAlignment="Center"
                                                          Checked="FeatEnable_Changed" Unchecked="FeatEnable_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [FeatTitleBarLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="FeatWgBehHide" GroupName="FeatWgBeh" Tag="wg:hide" Content="{Binding [FeatBehHide], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="FeatBeh_Changed"/>
                                            <RadioButton x:Name="FeatWgBehDisable" GroupName="FeatWgBeh" Tag="wg:disable" Content="{Binding [FeatBehDisable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="FeatBeh_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [FeatShowBtnLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatWgShowBtn" Tag="wg" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="FeatShowBtn_Changed" Unchecked="FeatShowBtn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DNS -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DNS" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [FeatDnsDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [SettingsFeatureEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatDnsEnableToggle" Tag="dns" Style="{StaticResource ToggleSwitch}"
                                                          Width="44" Height="22" VerticalAlignment="Center"
                                                          Checked="FeatEnable_Changed" Unchecked="FeatEnable_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [FeatTitleBarLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="FeatDnsBehHide" GroupName="FeatDnsBeh" Tag="dns:hide" Content="{Binding [FeatBehHide], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="FeatBeh_Changed"/>
                                            <RadioButton x:Name="FeatDnsBehDisable" GroupName="FeatDnsBeh" Tag="dns:disable" Content="{Binding [FeatBehDisable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="FeatBeh_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [FeatShowBtnLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatDnsShowBtn" Tag="dns" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="FeatShowBtn_Changed" Unchecked="FeatShowBtn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Automation -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [SettingsTabAutomation], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [FeatAutoDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [SettingsFeatureEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatAutoEnableToggle" Tag="auto" Style="{StaticResource ToggleSwitch}"
                                                          Width="44" Height="22" VerticalAlignment="Center"
                                                          Checked="FeatEnable_Changed" Unchecked="FeatEnable_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [FeatTitleBarLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="FeatAutoBehHide" GroupName="FeatAutoBeh" Tag="auto:hide" Content="{Binding [FeatBehHide], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="FeatBeh_Changed"/>
                                            <RadioButton x:Name="FeatAutoBehDisable" GroupName="FeatAutoBeh" Tag="auto:disable" Content="{Binding [FeatBehDisable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="FeatBeh_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [FeatShowBtnLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatAutoShowBtn" Tag="auto" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="FeatShowBtn_Changed" Unchecked="FeatShowBtn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Activity log -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [FeatLogTitle], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [FeatLogDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [SettingsFeatureEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatLogEnableToggle" Tag="log" Style="{StaticResource ToggleSwitch}"
                                                          Width="44" Height="22" VerticalAlignment="Center"
                                                          Checked="FeatEnable_Changed" Unchecked="FeatEnable_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [FeatTitleBarLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="FeatLogBehHide" GroupName="FeatLogBeh" Tag="log:hide" Content="{Binding [FeatBehHide], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="FeatBeh_Changed"/>
                                            <RadioButton x:Name="FeatLogBehDisable" GroupName="FeatLogBeh" Tag="log:disable" Content="{Binding [FeatBehDisable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="FeatBeh_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [FeatShowBtnLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatLogShowBtn" Tag="log" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="FeatShowBtn_Changed" Unchecked="FeatShowBtn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Charts -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding [WizHistoryTitle], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [FeatChartsDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [SettingsFeatureEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatChartsEnableToggle" Tag="charts" Style="{StaticResource ToggleSwitch}"
                                                          Width="44" Height="22" VerticalAlignment="Center"
                                                          Checked="FeatEnable_Changed" Unchecked="FeatEnable_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [FeatTitleBarLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="FeatChartsBehHide" GroupName="FeatChartsBeh" Tag="charts:hide" Content="{Binding [FeatBehHide], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="FeatBeh_Changed"/>
                                            <RadioButton x:Name="FeatChartsBehDisable" GroupName="FeatChartsBeh" Tag="charts:disable" Content="{Binding [FeatBehDisable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="FeatBeh_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding [FeatShowBtnLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ToggleButton x:Name="FeatChartsShowBtn" Tag="charts" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="FeatShowBtn_Changed" Unchecked="FeatShowBtn_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- (View presets removed.) -->

                            <!-- Import / Export & preset (moved here from the dissolved Advanced tab) -->
                            <TextBlock Text="{Binding [SettingsImportExportSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsImportExportInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding [BtnExportSettings], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                        Click="ExportSettings_Click"/>
                                <Button Content="{Binding [BtnImportSettings], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                        Margin="8,0,0,0" Click="ImportSettings_Click"/>
                                <Button Content="{Binding [BtnExportPreset], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                        Margin="8,0,0,0" Click="ExportPreset_Click"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- ══ STARTUP PAGE (start with Windows / minimized / confirm-exit + install) ══ -->
                        <StackPanel x:Name="PageStartup" Visibility="Collapsed">

                            <!-- Startup & exit -->
                            <TextBlock Text="{Binding [SettingsSectionStartupExit], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Start with Windows toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsStartWithWindows], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsStartWithWindowsDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="StartWithWindowsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="StartWithWindows_Changed"
                                                  Unchecked="StartWithWindows_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Start minimized toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsStartMinimized], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsStartMinimizedDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="StartMinimizedToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="StartMinimized_Changed"
                                                  Unchecked="StartMinimized_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Confirm on close toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsConfirmOnExit], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsConfirmOnExitDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ConfirmOnCloseToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ConfirmOnClose_Changed"
                                                  Unchecked="ConfirmOnClose_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Installation (moved here from the dissolved Advanced tab) -->
                            <TextBlock Text="{Binding [SettingsSectionInstall], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="InstallStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="InstallPathLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <CheckBox x:Name="SuppressUpdatePromptToggle"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                  Margin="0,8,0,0"
                                                  Checked="SuppressUpdatePrompt_Changed"
                                                  Unchecked="SuppressUpdatePrompt_Changed">
                                            <CheckBox.Content>
                                                <TextBlock Text="{Binding [SettingsSuppressUpdatePrompt], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap" MaxWidth="260"/>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="InstallBtn"
                                            Style="{StaticResource FlatBtn}"
                                            FontSize="11" Padding="14,6" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="InstallBtn_Click"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ TUNNELS PAGE (labelled "WireGuard") ══════════════════════════ -->
                        <StackPanel x:Name="PageTunnels" Visibility="Collapsed">

                            <!-- Feature-off stub: shown when WireGuard is disabled (see ShowTab). -->
                            <Border x:Name="TunnelsFeatureStub" Visibility="Collapsed"
                                    Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsWgOffTitle], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [SettingsWgOffDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="{Binding [SettingsWgOffEnable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SuccessBtn}"
                                            FontSize="10" Padding="14,6" HorizontalAlignment="Left"
                                            Click="EnableTunnelsFromStub_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Real WireGuard settings (hidden while the stub shows) -->
                            <StackPanel x:Name="TunnelsFeatureContent">

                            <!-- Groups -->
                            <TextBlock Text="{Binding [SettingsSectionGroups], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Group list + add row (top) -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Add new group row at top -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="NewGroupNameBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="8,5" Margin="0,0,6,0">
                                            <TextBox.Resources>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="1"
                                                Content="{Binding [BtnAddGroup], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource SuccessBtn}" FontSize="10" Padding="10,5"
                                                Click="AddGroup_Click"/>
                                    </Grid>
                                    <!-- Group list -->
                                    <ItemsControl x:Name="GroupListPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Auto-reconnect mode -->
                            <TextBlock Text="{Binding [SettingsAutoReconnectModeTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsAutoReconnectModeDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ArModeOff" GroupName="ArMode" Tag="off"
                                                     Content="{Binding [SettingsModeOff], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="ArMode_Changed"/>
                                        <RadioButton x:Name="ArModePerTunnel" GroupName="ArMode" Tag="per-tunnel"
                                                     Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="ArMode_Changed"/>
                                        <RadioButton x:Name="ArModeAlways" GroupName="ArMode" Tag="always"
                                                     Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="ArMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Kill switch mode -->
                            <TextBlock Text="{Binding [SettingsKillSwitchModeTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsKillSwitchModeDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="KsModePerTunnel" GroupName="KsMode" Tag="per-tunnel"
                                                     Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="KsMode_Changed"/>
                                        <RadioButton x:Name="KsModeAlways" GroupName="KsMode" Tag="always"
                                                     Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="KsMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Config validation -->
                            <TextBlock Text="{Binding [SettingsConfigValidationTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsConfigValidationDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="SkipTunnelValidationToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Margin="0,0,8,0"
                                                      Checked="SkipTunnelValidation_Changed"
                                                      Unchecked="SkipTunnelValidation_Changed"/>
                                        <TextBlock Text="{Binding [SettingsSkipValidationLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- (Title-bar tunnels button controls moved to General → Features.) -->

                            <!-- Display toggles (below) -->
                            <TextBlock Text="{Binding [SettingsSectionDisplay], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Always hide tunnel count toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideTunnelCount], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideTunnelCountDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideTunnelCountToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideTunnelCount_Changed"
                                                  Unchecked="HideTunnelCount_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Hide empty tunnel groups toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideEmptyGroups], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideEmptyGroupsDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideEmptyGroupsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideEmptyGroups_Changed"
                                                  Unchecked="HideEmptyGroups_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            </StackPanel>
                            <!-- /TunnelsFeatureContent -->

                        </StackPanel>

                        <!-- ══ WIFI PAGE (labelled "Automation": default action + open network + trusted) ══ -->
                        <!-- The WiFi rules list lives on the main window; it is intentionally
                             NOT duplicated here - this page only has the automation settings. -->
                        <StackPanel x:Name="PageWifi" Visibility="Collapsed">

                            <!-- Feature-off stub: shown when Automation is disabled (enable/behaviour live in General → Features). -->
                            <Border x:Name="AutoFeatureStub" Visibility="Collapsed"
                                    Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsAutoOffTitle], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [SettingsAutoOffDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="{Binding [SettingsAutoOffEnable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SuccessBtn}"
                                            FontSize="10" Padding="14,6" HorizontalAlignment="Left"
                                            Click="EnableAutomationFromStub_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Real Automation settings (hidden while the stub shows) -->
                            <StackPanel x:Name="AutoFeatureContent">

                            <!-- Tunnel-only WiFi sections - hidden in DNS-only mode (see ApplyFeatureSectionVisibility) -->
                            <StackPanel x:Name="WifiTunnelOnlySections">
                            <!-- WiFi Default Action (fallback when no rule matches) -->
                            <TextBlock Text="{Binding [SettingsSectionDefaultAction], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"
                                       Margin="0,16,0,4"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDefaultActionInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <RadioButton x:Name="ActionNone"
                                                 Content="{Binding [DefaultActionNone], Source={x:Static local:Lang.Instance}}"
                                                 Checked="DefaultAction_Changed" Tag="none" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="ActionDiscon"
                                                 Content="{Binding [DefaultActionDisconnect], Source={x:Static local:Lang.Instance}}"
                                                 Checked="DefaultAction_Changed" Tag="disconnect" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="ActionActivate"
                                                 Checked="DefaultAction_Changed" Tag="activate">
                                        <RadioButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [DefaultActionActivate], Source={x:Static local:Lang.Instance}}"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox x:Name="DefaultTunnelBox" Margin="8,0,0,0"
                                                          MinWidth="140" FontSize="11" IsEditable="True"
                                                          SelectionChanged="DefaultTunnelBox_SelectionChanged"
                                                          LostFocus="DefaultTunnelBox_LostFocus"/>
                                            </StackPanel>
                                        </RadioButton.Content>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Open network protection -->
                            <TextBlock Text="{Binding [SettingsSectionOpenWifi], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsOpenWifiInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [OpenWifiTunnel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="OpenWifiTunnelBox"
                                              MinWidth="160" FontSize="11"
                                              SelectionChanged="OpenWifiTunnel_Changed"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            <!-- /Tunnel-only WiFi sections -->

                            <!-- Trusted-network auto-protect -->
                            <TextBlock Text="{Binding [SettingsSectionTrustedNet], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsTrustedNetInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsTrustedList], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TrustedNetworksBox" AcceptsReturn="True"
                                             MinHeight="60" MaxHeight="140" FontSize="11"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             LostFocus="TrustedNetworks_LostFocus"/>
                                    <Button x:Name="AddCurrentTrustedBtn"
                                            Content="{Binding [SettingsTrustedAddCurrent], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource FlatBtn}"
                                            FontSize="10" Padding="10,4" HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Click="AddCurrentTrusted_Click"/>
                                    <TextBlock Text="{Binding [SettingsTrustedListDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Display toggles -->
                            <TextBlock Text="{Binding [SettingsSectionDisplay], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Hide WiFi rules on main window toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideWifiRules], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideWifiRulesDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideWifiRulesToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideWifiRules_Changed"
                                                  Unchecked="HideWifiRules_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Show rules column toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsShowRulesColumn], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsShowRulesColumnDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ShowRulesColumnToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ShowRulesColumn_Changed"
                                                  Unchecked="ShowRulesColumn_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            </StackPanel>
                            <!-- /AutoFeatureContent -->

                        </StackPanel>

                        <!-- ══ DNS PAGE ═════════════════════════════════════ -->
                        <StackPanel x:Name="PageDns" Visibility="Collapsed">

                            <!-- Feature-off stub: shown when DNS automation is disabled (see ShowTab). -->
                            <Border x:Name="DnsFeatureStub" Visibility="Collapsed"
                                    Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsDnsOffTitle], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding [SettingsDnsOffDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="{Binding [SettingsDnsOffEnable], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SuccessBtn}"
                                            FontSize="10" Padding="14,6" HorizontalAlignment="Left"
                                            Click="EnableDnsFromStub_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Real DNS settings (hidden while the stub shows) -->
                            <StackPanel x:Name="DnsFeatureContent">

                            <!-- ── DNS automation ─────────────────────────────────────────── -->
                            <TextBlock Text="{Binding [SettingsSectionDns], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDnsInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Master toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsDnsEnableLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsDnsEnableDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="DnsAutomationToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Checked="DnsAutomation_Changed" Unchecked="DnsAutomation_Changed"
                                                  Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <!-- Defaults + address families -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [SettingsDnsDefaultLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,10,6"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DnsDefaultBox" FontSize="11" Margin="0,0,0,6"
                                              SelectionChanged="DnsDefault_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [SettingsDnsOpenLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,10,6"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DnsOpenBox" FontSize="11" Margin="0,0,0,6"
                                              SelectionChanged="DnsOpen_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [SettingsDnsFamiliesLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DnsFamiliesBox" FontSize="11"
                                              SelectionChanged="DnsFamilies_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Profiles manager -->
                            <TextBlock Text="{Binding [SettingsDnsProfilesHeader], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}" Margin="0,10,0,4"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDnsProfilesInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <ListView x:Name="DnsProfilesList" MinHeight="60" MaxHeight="160" FontSize="11"
                                              Background="Transparent" BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              SelectionChanged="DnsProfilesList_SelectionChanged"
                                              MouseDoubleClick="DnsProfilesList_DoubleClick">
                                        <!-- Container style matches the main-window DNS list: a transparent
                                             row that stretches full width with hover/selected tints. Without
                                             it the default ListViewItem chrome hid the row content. -->
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background"                 Value="Transparent"/>
                                                <Setter Property="BorderThickness"            Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding"                    Value="4,3"/>
                                                <Setter Property="Foreground"                 Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ServersDisplay}"
                                                               Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding EncryptionDisplay}"
                                                               Foreground="{DynamicResource Accent}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="DnsAddBtn" Content="{Binding [BtnDnsAddProfile], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,4" Margin="0,0,6,0"
                                                Click="DnsAdd_Click"/>
                                        <Button x:Name="DnsPresetsBtn" Content="{Binding [BtnDnsAddPresets], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,4" Margin="0,0,6,0"
                                                Click="DnsPresets_Click"/>
                                        <Button x:Name="DnsEditBtn" Content="{Binding [BtnDnsEditProfile], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,4" Margin="0,0,6,0"
                                                IsEnabled="False" Click="DnsEdit_Click"/>
                                        <Button x:Name="DnsRemoveBtn" Content="{Binding [BtnDnsRemoveProfile], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,4"
                                                IsEnabled="False" Click="DnsRemove_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- (Title-bar DNS button controls moved to General → Features.) -->

                            <!-- DNS leak protection (moved here from the dissolved Advanced tab) -->
                            <TextBlock Text="{Binding [SettingsSectionDnsLeak], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDnsLeakInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Option 1: smart multi-homed name resolution -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakSmartLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakSmartDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DnsLeakStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button x:Name="DnsLeakDisableBtn"
                                                    Content="{Binding [BtnDnsLeakDisable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource SuccessBtn}" FontSize="10" Padding="12,5"
                                                    Click="DnsLeakDisable_Click"/>
                                            <Button x:Name="DnsLeakEnableBtn"
                                                    Content="{Binding [BtnDnsLeakEnable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                    Margin="6,0,0,0" Click="DnsLeakEnable_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}"
                                            Margin="0,12,0,12"/>

                                    <!-- Option 2: parallel A / AAAA queries -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakParallelLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakParallelDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DnsParallelStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button x:Name="DnsParallelDisableBtn"
                                                    Content="{Binding [BtnDnsLeakDisable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource SuccessBtn}" FontSize="10" Padding="12,5"
                                                    Click="DnsParallelDisable_Click"/>
                                            <Button x:Name="DnsParallelEnableBtn"
                                                    Content="{Binding [BtnDnsLeakEnable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                    Margin="6,0,0,0" Click="DnsParallelEnable_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}"
                                            Margin="0,12,0,12"/>

                                    <!-- Possible-leak alerts: independent delivery channels (all off = disabled) -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakWarnLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakWarnDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,8"/>

                                    <!-- Channel: inline status icon (next to bandwidth) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertIcon], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="ShowDnsIndicatorToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="ShowDnsIndicator_Changed"
                                                      Unchecked="ShowDnsIndicator_Changed"/>
                                    </Grid>

                                    <!-- Channel: activity-log warning -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertLog], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="DnsLeakWarnLogToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="DnsLeakWarnLog_Changed"
                                                      Unchecked="DnsLeakWarnLog_Changed"/>
                                    </Grid>

                                    <!-- Channel: tray toast -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertToast], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="DnsLeakWarnToastToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="DnsLeakWarnToast_Changed"
                                                      Unchecked="DnsLeakWarnToast_Changed"/>
                                    </Grid>

                                    <TextBlock Text="{Binding [SettingsDnsLeakReboot], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            </StackPanel>
                            <!-- /DnsFeatureContent -->

                        </StackPanel>

                        <!-- ══ APPEARANCE PAGE ══════════════════════════════ -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">

                            <!-- (Title-bar section-button controls moved to General → Features.) -->

                            <!-- System theme section -->
                            <TextBlock Text="{Binding [SettingsSectionTheme], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsThemeAutoLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsThemeAutoDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SysModeLight" GroupName="SysMode" Tag="light"
                                                     Content="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="SystemMode_Changed"/>
                                        <RadioButton x:Name="SysModeDark" GroupName="SysMode" Tag="dark"
                                                     Content="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="SystemMode_Changed"/>
                                        <RadioButton x:Name="SysModeAuto" GroupName="SysMode" Tag="auto"
                                                     Content="{Binding [WizardThemeAuto], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="SystemMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Theme -->
                            <TextBlock Text="{Binding [SettingsThemeSectionTitle], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="ThemePicker" Padding="8,4"
                                              SelectionChanged="ThemePicker_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                           Margin="0,2"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" x:Name="ManageThemesBtn"
                                            Content="{Binding [BtnManageThemes], Source={x:Static local:Lang.Instance}}" Style="{StaticResource FlatBtn}"
                                            FontSize="10" Padding="12,5" Margin="8,0,0,0"
                                            VerticalAlignment="Stretch"
                                            Click="OpenThemeBuilder_Click"
                                            ToolTip="{Binding [ManageThemesTip], Source={x:Static local:Lang.Instance}}"/>
                                    <Button Grid.Column="2" x:Name="DownloadThemesBtn"
                                            Content="{Binding [BtnDownloadThemes], Source={x:Static local:Lang.Instance}}" Style="{StaticResource FlatBtn}"
                                            FontSize="10" Padding="12,5" Margin="6,0,0,0"
                                            VerticalAlignment="Stretch"
                                            Click="DownloadThemes_Click"
                                            ToolTip="{Binding [DownloadThemesTip], Source={x:Static local:Lang.Instance}}"/>
                                    <TextBlock Grid.Column="3" x:Name="ThemeUpdatesBadge"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Visibility="Collapsed" Cursor="Hand"
                                               MouseLeftButtonUp="DownloadThemes_Click"/>
                                </Grid>
                            </Border>
                            <!-- Theme preview: test dark and light variant -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsThemePreviewDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" x:Name="DarkThemePreviewBtn"
                                            Content="{Binding [SettingsThemePreviewDarkBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3" Width="72"
                                            Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource TextMuted}"
                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                            Click="DarkThemePreview_Click"
                                            ToolTip="{Binding [SettingsThemePreviewDarkTip], Source={x:Static local:Lang.Instance}}"/>
                                    <Button Grid.Column="2" x:Name="LightThemePreviewBtn"
                                            Content="{Binding [SettingsThemePreviewLightBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3" Width="72"
                                            Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource TextMuted}"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Click="LightThemePreview_Click"
                                            ToolTip="{Binding [SettingsThemePreviewLightTip], Source={x:Static local:Lang.Instance}}"/>
                                </Grid>
                            </Border>

                            <!-- ── Font override ─────────────────────────────── -->
                            <TextBlock Text="{Binding [SettingsFontSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsFontOverrideLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsFontOverrideDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="FontOverrideToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="FontOverride_Changed"
                                                  Unchecked="FontOverride_Changed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="FontPickerPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <!-- Font family picker -->
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SettingsFontFamilyLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="FontFamilyPicker"
                                                  IsEditable="True"
                                                  MaxDropDownHeight="220"
                                                  FontSize="11" Padding="6,4"
                                                  TextSearch.TextPath="DisplayName"
                                                  SelectionChanged="FontFamilyPicker_Changed"
                                                  LostFocus="FontFamilyPicker_LostFocus">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="{Binding FontFamily}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding [SettingsFontFamilyHint], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Live preview - between picker and slider so you see the font before sizing -->
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SettingsFontPreviewSection], Source={x:Static local:Lang.Instance}}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="FontPreviewLabel"
                                                   Text="{Binding [SettingsFontPreviewSample], Source={x:Static local:Lang.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Font size slider + preview button -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding [SettingsFontSizeLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="FontSizeValueLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" Text="12 pt"/>
                                        </Grid>
                                        <!-- min────●────max  [▶ Preview] -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" x:Name="FontSizeSlider"
                                                    Minimum="8" Maximum="18" Value="12"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="2"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="FontSizeSlider_Changed"/>
                                            <Button Grid.Column="1" x:Name="FontPreviewBtn"
                                                    Content="{Binding [SettingsFontPreviewBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3"
                                                    Width="76"
                                                    Style="{StaticResource FlatBtn}"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    Click="FontPreview_Click"
                                                    ToolTip="{Binding [SettingsFontPreviewApplyTip], Source={x:Static local:Lang.Instance}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Notifications moved to the "Notifications & history" tab -->

                            <!-- Data-cap usage indicator: rings (compact) vs bars (taller). A display
                                 choice for the tunnel list - placed under Notifications. Tunnel-only:
                                 hidden in DNS-only mode (see ApplyFeatureSectionVisibility). -->
                            <StackPanel x:Name="CapIndicatorSection">
                            <TextBlock Text="{Binding [SettingsCapIndicatorTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"
                                       Margin="0,16,0,4"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsCapIndicatorDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CapStyleRings" GroupName="CapStyle" Tag="rings"
                                                     Content="{Binding [SettingsCapIndicatorRings], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="CapStyle_Changed"/>
                                        <RadioButton x:Name="CapStyleBars" GroupName="CapStyle" Tag="bars"
                                                     Content="{Binding [SettingsCapIndicatorBars], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="CapStyle_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <!-- Interface -->
                            <TextBlock Text="{Binding [SettingsInterfaceSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"
                                       Margin="0,16,0,4"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsShowActivityLogLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsShowActivityLogDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ShowActivityLogToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ShowActivityLog_Changed"
                                                  Unchecked="ShowActivityLog_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ DIAGNOSTICS PAGE ════════════════════════════════ -->
                        <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">

                            <!-- Diagnostics / Tester -->
                            <TextBlock Text="{Binding [SettingsSectionTester], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [TesterInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Mode selection -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox x:Name="TestLocalToggle" IsChecked="True" Margin="0,0,16,0"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Content="{Binding [TesterModeLocal], Source={x:Static local:Lang.Instance}}"/>
                                        <CheckBox x:Name="TestDnsToggle" IsChecked="True" Margin="0,0,16,0"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Content="{Binding [TesterModeDns], Source={x:Static local:Lang.Instance}}"/>
                                        <CheckBox x:Name="TestCliToggle" IsChecked="True"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Content="{Binding [TesterModeCli], Source={x:Static local:Lang.Instance}}"/>
                                    </WrapPanel>

                                    <!-- Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="RunTestsBtn"
                                                Content="{Binding [BtnRunTests], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource SuccessBtn}" FontSize="10" Padding="14,5"
                                                Click="RunTests_Click"/>
                                        <Button x:Name="CopyTestLogBtn"
                                                Content="{Binding [BtnCopyLog], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                Margin="8,0,0,0" Click="CopyTestLog_Click"/>
                                        <Button x:Name="ClearTestLogBtn"
                                                Content="{Binding [BtnClearLog], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                Margin="8,0,0,0" Click="ClearTestLog_Click"/>
                                    </StackPanel>

                                    <!-- Debug log -->
                                    <Border Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBox x:Name="TestLogBox"
                                                 Height="240" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Padding="8,6"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- System diagnostics -->
                            <TextBlock Text="{Binding [SysDiagTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SysDiagInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="{Binding [SysDiagOpen], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="14,5"
                                        Click="OpenSystemDiagnostics_Click"/>
                            </StackPanel>

                            <!-- Theme repository (moved here from the dissolved Advanced tab) -->
                            <TextBlock Text="{Binding [SettingsThemeRepoHdr], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsThemeRepoDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="SharedThemesRepoBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                 Padding="6,4" VerticalContentAlignment="Center"
                                                 TextChanged="SharedThemesRepo_Changed"/>
                                        <Button Grid.Column="1" x:Name="ResetThemesRepoBtn"
                                                Content="{Binding [SettingsThemeRepoDefault], Source={x:Static local:Lang.Instance}}" Style="{StaticResource FlatBtn}"
                                                FontSize="10" Padding="12,5" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Click="ResetThemesRepo_Click"
                                                ToolTip="{Binding [SettingsThemeRepoResetTip], Source={x:Static local:Lang.Instance}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ══ NOTIFICATIONS PAGE (tray / toast only) ════════════════════════════════════ -->
                        <StackPanel x:Name="PageNotifications" Visibility="Collapsed">

                            <!-- Notifications (tray popup + duration) -->
                            <TextBlock Text="{Binding [SettingsTrayPopupLabel], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsTrayPopupLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsTrayPopup], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="TrayPopupToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="TrayPopup_Changed" Unchecked="TrayPopup_Changed"/>
                                </Grid>
                            </Border>
                            <!-- Notification duration -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsNotifDuration], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="NotifDurationPicker"
                                              Width="80" FontSize="11" Margin="12,0,0,0"
                                              SelectionChanged="NotifDuration_Changed"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ HISTORY PAGE (feature: capture + charts + list) ════════════════════════════════════ -->
                        <StackPanel x:Name="PageHistory" Visibility="Collapsed">

                            <!-- Capture & Show -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ── Capture column ── -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [HistoryCaptureLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0,0,0,10"/>
                                        <!-- Capture connections -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryCaptureConnectionsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryCaptureConnectionsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="StoreConnectionHistoryToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="StoreConnectionHistory_Changed"
                                                          Unchecked="StoreConnectionHistory_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Capture WiFi -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryCaptureWifiLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryCaptureWifiDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="StoreWifiHistoryToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="StoreWifiHistory_Changed"
                                                          Unchecked="StoreWifiHistory_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Capture DNS -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryCaptureDnsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryCaptureDnsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="StoreDnsHistoryToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="StoreDnsHistory_Changed"
                                                          Unchecked="StoreDnsHistory_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Rectangle Grid.Column="1" Width="1" Margin="12,0"
                                               Fill="{DynamicResource BorderColor}" VerticalAlignment="Stretch"/>

                                    <!-- ── Show column ── -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [HistoryShowLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0,0,0,10"/>
                                        <!-- Show connections -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryShowConnectionsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryShowConnectionsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="ShowTimelineToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="ShowTimeline_Changed"
                                                          Unchecked="ShowTimeline_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Show WiFi -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryShowWifiLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryShowWifiDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="ShowWifiInChartToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="ShowWifiInChart_Changed"
                                                          Unchecked="ShowWifiInChart_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Show DNS -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryShowDnsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryShowDnsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="ShowDnsInChartToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="ShowDnsInChart_Changed"
                                                          Unchecked="ShowDnsInChart_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Activity chart options -->
                            <TextBlock Text="{Binding [HistoryActivityChartTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [HistoryTimeRangeLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="ChartRange24h"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange24h], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Margin="0,0,16,0"
                                                     Checked="InfoTimeRange_Changed"/>
                                        <RadioButton x:Name="ChartRange7d"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange7d], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Margin="0,0,16,0"
                                                     Checked="InfoTimeRange_Changed"/>
                                        <RadioButton x:Name="ChartRange31d"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange31d], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Checked="InfoTimeRange_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [HistorySectionTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- List -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column header bar -->
                                    <Border Grid.Row="0"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,5,8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding [HistoryColTunnel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding [HistoryColDuration], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding [HistoryColSource], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </Border>

                                    <!-- History rows -->
                                    <ListView Grid.Row="1" x:Name="HistoryList"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MinHeight="120" MaxHeight="306"
                                              FontFamily="{DynamicResource Theme.FontFamily}"
                                              FontSize="{DynamicResource Theme.FontSize.Small}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background"                  Value="Transparent"/>
                                                <Setter Property="BorderThickness"             Value="0"/>
                                                <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
                                                <Setter Property="Padding"                     Value="0"/>
                                                <Setter Property="Margin"                      Value="0"/>
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                                                <Setter Property="ToolTipService.ShowDuration"     Value="15000"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderThickness="0" CornerRadius="4">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ToolTip">
                                                    <Setter.Value>
                                                        <ToolTip Background="Transparent" BorderThickness="0"
                                                                 Padding="0" HasDropShadow="False"
                                                                 DataContext="{Binding Path=PlacementTarget.DataContext,
                                                                               RelativeSource={RelativeSource Self}}">
                                                            <Border Background="{DynamicResource Surface}"
                                                                    BorderBrush="{DynamicResource BorderColor}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                                                    Padding="12,10,16,10"
                                                                    MinWidth="240">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" Opacity="0.4"
                                                                                      BlurRadius="12" ShadowDepth="3"
                                                                                      Direction="270"/>
                                                                </Border.Effect>
                                                                <StackPanel>
                                                                    <!-- Tunnel name header -->
                                                                    <TextBlock Text="{Binding TunnelName}"
                                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               Foreground="{DynamicResource Accent}"
                                                                               Margin="0,0,0,8"/>
                                                                    <!-- Connected at -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupConnected], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding FullWhenDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Time range -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupPeriod], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding TimeRangeDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Duration -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupDuration], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DurationDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Traffic -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupTraffic], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding TrafficDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Via / trigger -->
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryColSource], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Source}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TunnelName}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DurationDisplay}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Source}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Clear button -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding [HistoryClearBtn], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource DangerBtn}" FontSize="10" Padding="10,3"
                                        Click="ClearHistory_Click"/>
                                <TextBlock x:Name="HistoryCountLabel"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- ══ ACTIVITY LOG PAGE (feature: log level + persistence) ════════════════════════════════════ -->
                        <StackPanel x:Name="PageLog" Visibility="Collapsed">

                            <!-- Log level + persistence -->
                            <TextBlock Text="{Binding [SettingsSectionLog], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}" Margin="0,10,0,4"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsLogLevel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="LogLevelPicker"
                                                  MinWidth="110" FontSize="11" Padding="8,4"
                                                  SelectionChanged="LogLevel_Changed"/>
                                    </Grid>

                                    <!-- Clear log on start -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ToggleButton x:Name="ClearLogOnStartToggle" Style="{StaticResource ToggleSwitch}"
                                                      Margin="0,0,10,0" VerticalAlignment="Center"
                                                      Click="ClearLogOnStart_Changed"/>
                                        <TextBlock Text="{Binding [SettingsClearLogOnStart], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [SettingsClearLogOnStartTip], Source={x:Static local:Lang.Instance}}"/>
                                    </StackPanel>

                                    <!-- Max log size -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsMaxLogSize], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding [SettingsMaxLogSizeTip], Source={x:Static local:Lang.Instance}}"/>
                                        <TextBox Grid.Column="1" x:Name="MaxLogSizeBox" Width="90" FontSize="11" Padding="6,4"
                                                 VerticalAlignment="Center" LostFocus="MaxLogSize_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ══ ABOUT PAGE ══════════════════════════════════════ -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">

                            <!-- Updates -->
                            <TextBlock Text="{Binding [SettingsSectionUpdate], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Version, build stamp, status badge, last-checked -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                   x:Name="VersionLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   x:Name="BuildLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,1,0,0"/>
                                        <!-- Status badge pill - its own row, right-aligned -->
                                        <Border Grid.Row="2" Grid.Column="1" x:Name="UpdateStatusBadge"
                                                CornerRadius="10" Padding="10,4"
                                                HorizontalAlignment="Right" Margin="0,4,0,4">
                                            <TextBlock x:Name="UpdateStatusLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   x:Name="LastCheckedLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    </Grid>

                                    <!-- Theme update indicator - passive result of the last check; click opens Community themes -->
                                    <Border x:Name="AboutThemeUpdatesRow"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                                            Cursor="Hand" Visibility="Collapsed"
                                            MouseLeftButtonUp="DownloadThemes_Click"
                                            ToolTip="{Binding [AboutThemeUpdatesTooltip], Source={x:Static local:Lang.Instance}}">
                                        <TextBlock x:Name="AboutThemeUpdatesLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Separator -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                                    <!-- Frequency pills row -->
                                    <TextBlock Text="{Binding [UpdateCheckFrequencyLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="FreqOnStart" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckOnStart], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="UpdateFreq_Changed" Tag="onstart"/>
                                        <RadioButton x:Name="FreqDaily" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckDaily], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="daily"/>
                                        <RadioButton x:Name="FreqWeekly" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckWeekly], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="weekly"/>
                                        <RadioButton x:Name="FreqManual" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckManual], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="manual"/>
                                    </StackPanel>

                                    <!-- Action buttons row -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateBtn"
                                                Style="{StaticResource FlatBtn}"
                                                FontSize="10" Padding="12,6"
                                                Click="CheckUpdate_Click"/>
                                        <Button x:Name="DoUpdateBtn"
                                                Style="{StaticResource SuccessBtn}"
                                                FontSize="10" Padding="12,6" Margin="8,0,0,0"
                                                Visibility="Collapsed"
                                                Click="DoUpdate_Click"/>
                                    </StackPanel>

                                    <!-- Download / extract / apply progress -->
                                    <TextBlock x:Name="UpdateProgressLabel"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource Accent}"
                                               Margin="0,8,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>

                                </StackPanel>
                            </Border>

                            <!-- MasselGUARD -->
                            <TextBlock Text="MasselGUARD"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}">
                                        <Run Text="{Binding [AboutBy], Source={x:Static local:Lang.Instance}, Mode=OneWay}"/><Run Text=" Harold Masselink"/>
                                    </TextBlock>
                                    <TextBlock x:Name="GithubLink"
                                               Text="github.com/masselink/MasselGUARD"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               Foreground="{DynamicResource Accent}"
                                               Cursor="Hand" TextDecorations="Underline"
                                               Margin="0,4,0,0"
                                               MouseLeftButtonUp="GithubLink_Click"/>

                                    <!-- Credits -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,10,0,10"/>
                                    <TextBlock Text="{Binding [AboutCredits], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap">
                                        <Run Text="MasselGUARD - Harold Masselink"/><LineBreak/>
                                        <Run Text="WireGuard - Jason A. Donenfeld / WireGuard LLC"/><LineBreak/>
                                        <Run Text=".NET runtime - Microsoft"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [AboutTrademark], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="9" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <!-- License -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,10,0,10"/>
                                    <TextBlock Text="{Binding [AboutLicensedMit], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="LicenseLink"
                                                   Text="{Binding [AboutViewLicense], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   Cursor="Hand" TextDecorations="Underline"
                                                   MouseLeftButtonUp="LicenseLink_Click"/>
                                        <TextBlock Text="   ·   "
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock x:Name="NoticesLink"
                                                   Text="{Binding [AboutThirdPartyNotices], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   Cursor="Hand" TextDecorations="Underline"
                                                   MouseLeftButtonUp="NoticesLink_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- What's New -->
                            <TextBlock Text="{Binding [AboutWhatsNew], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid Height="220">

                                    <!-- Success state: rendered markdown -->
                                    <RichTextBox x:Name="WhatsNewBox"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 FontFamily="{DynamicResource Theme.FontFamily}"
                                                 FontSize="10"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Visibility="Collapsed"
                                                 Padding="0"/>

                                    <!-- Error state: shown when GitHub is unreachable -->
                                    <StackPanel x:Name="WhatsNewErrorPanel"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🌐"
                                                   FontSize="30"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding [AboutReleaseNotesError], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,18"/>
                                        <TextBlock Text="github.com/masselink/MasselGUARD"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextDecorations="Underline"
                                                   Cursor="Hand"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"
                                                   MouseLeftButtonUp="WhatsNewLink_GitHub_Click"/>
                                        <TextBlock Text="masselink.net"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextDecorations="Underline"
                                                   Cursor="Hand"
                                                   HorizontalAlignment="Center"
                                                   MouseLeftButtonUp="WhatsNewLink_Site_Click"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                  </AdornerDecorator>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="{Binding [BtnCancel], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Padding="20,6" Margin="0,0,8,0"
                            Click="CloseBtn_Click"/>
                    <Button x:Name="SaveBtn"
                            Content="{Binding [BtnSaveSettings], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource SuccessBtn}" Padding="20,6"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
