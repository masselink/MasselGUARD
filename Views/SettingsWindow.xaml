<Window x:Class="MasselGUARD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [SettingsTitle], Source={x:Static local:Lang.Instance}}"
        Width="700" Height="560"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="{Binding [SettingsTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="&#x2715;" Style="{StaticResource DangerBtn}"
                            HorizontalAlignment="Right"
                            Padding="10,4" Margin="0,0,8,0"
                            BorderThickness="0" Background="Transparent"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Tab body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tab sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,12,0,0">
                            <Button x:Name="TabBtnGeneral"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="General"
                                    Content="{Binding [SettingsTabGeneral],       Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnTunnels"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Tunnels"
                                    Content="{Binding [SettingsTabTunnels],       Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnWifi"          Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Wifi"
                                    Content="{Binding [SettingsTabWifi],          Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnAppearance"    Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Appearance"
                                    Content="{Binding [SettingsTabAppearance],    Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnHistory"       Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="History"
                                    Content="{Binding [SettingsTabHistory],       Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnAdvanced"      Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="Advanced"
                                    Content="{Binding [SettingsTabAdvanced],      Source={x:Static local:Lang.Instance}}"/>
                            <Button x:Name="TabBtnAbout"         Style="{StaticResource SideTabBtn}" Click="TabBtn_Click" Tag="About"
                                    Content="{Binding [SettingsTabAbout],         Source={x:Static local:Lang.Instance}}"/>
                        </StackPanel>
                        <!-- Wizard button pinned at bottom of sidebar -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                            <Button Style="{StaticResource SideTabBtn}" Click="RunWizard_Click"
                                    Content="{Binding [WizardRunAgain], Source={x:Static local:Lang.Instance}}"
                                    Padding="12,12" TextBlock.Foreground="{DynamicResource TextMuted}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab pages -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">

                        <!-- ══ GENERAL PAGE ══════════════════════════════════ -->
                        <StackPanel x:Name="PageGeneral">

                            <!-- Language (top of General) -->
                            <TextBlock Text="{Binding [SettingsSectionLanguage], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsLanguageLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LanguagePicker"
                                              MinWidth="160" FontSize="11" Padding="6,4"
                                              SelectionChanged="LanguagePicker_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding FlagImage}"
                                                           Width="20" Height="14"
                                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           SnapsToDevicePixels="True"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- ── APPEARANCE moved to its own tab ── -->

                            <!-- App Mode -->
                            <TextBlock Text="{Binding [SettingsSectionAppMode], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <RadioButton x:Name="ModeStandalone" GroupName="AppMode" Checked="Mode_Changed"
                                                 Style="{StaticResource ModeRadio}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [ModeStandaloneLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [ModeStandaloneDesc], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeCompanion" GroupName="AppMode" Checked="Mode_Changed"
                                                 Style="{StaticResource ModeRadio}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [ModeCompanionLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [ModeCompanionDesc], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeMixed" GroupName="AppMode" Checked="Mode_Changed"
                                                 Style="{StaticResource ModeRadio}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [ModeMixedLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding [ModeMixedDesc], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <Border x:Name="DllStatusPanel" Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                            CornerRadius="3" Padding="10,7" Margin="0,10,0,0">
                                        <TextBlock x:Name="DllStatusLabel" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Startup & exit -->
                            <TextBlock Text="Startup &amp; exit"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Start with Windows toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsStartWithWindows], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsStartWithWindowsDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="StartWithWindowsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="StartWithWindows_Changed"
                                                  Unchecked="StartWithWindows_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Confirm on close toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Confirm disconnect on exit"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="When active tunnels are running, ask before disconnecting them on exit. When off, tunnels are disconnected silently."
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ConfirmOnCloseToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ConfirmOnClose_Changed"
                                                  Unchecked="ConfirmOnClose_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ TUNNELS PAGE ══════════════════════════ -->
                        <StackPanel x:Name="PageTunnels" Visibility="Collapsed">

                            <!-- Groups -->
                            <TextBlock Text="{Binding [SettingsSectionGroups], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Group list + add row (top) -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Add new group row at top -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="NewGroupNameBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="8,5" Margin="0,0,6,0">
                                            <TextBox.Resources>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="1"
                                                Content="{Binding [BtnAddGroup], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource SuccessBtn}" FontSize="10" Padding="10,5"
                                                Click="AddGroup_Click"/>
                                    </Grid>
                                    <!-- Group list -->
                                    <ItemsControl x:Name="GroupListPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- Auto-reconnect mode -->
                            <TextBlock Text="{Binding [SettingsAutoReconnectModeTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsAutoReconnectModeDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ArModeOff" GroupName="ArMode" Tag="off"
                                                     Content="{Binding [SettingsModeOff], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="ArMode_Changed"/>
                                        <RadioButton x:Name="ArModePerTunnel" GroupName="ArMode" Tag="per-tunnel"
                                                     Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="ArMode_Changed"/>
                                        <RadioButton x:Name="ArModeAlways" GroupName="ArMode" Tag="always"
                                                     Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="ArMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Kill switch mode -->
                            <TextBlock Text="{Binding [SettingsKillSwitchModeTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsKillSwitchModeDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="KsModePerTunnel" GroupName="KsMode" Tag="per-tunnel"
                                                     Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="KsMode_Changed"/>
                                        <RadioButton x:Name="KsModeAlways" GroupName="KsMode" Tag="always"
                                                     Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="KsMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Config validation -->
                            <TextBlock Text="{Binding [SettingsConfigValidationTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsConfigValidationDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="SkipTunnelValidationToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Margin="0,0,8,0"
                                                      Checked="SkipTunnelValidation_Changed"
                                                      Unchecked="SkipTunnelValidation_Changed"/>
                                        <TextBlock Text="{Binding [SettingsSkipValidationLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Display toggles (below) -->
                            <TextBlock Text="{Binding [SettingsSectionDisplay], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Always hide tunnel count toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideTunnelCount], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideTunnelCountDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideTunnelCountToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideTunnelCount_Changed"
                                                  Unchecked="HideTunnelCount_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Hide empty tunnel groups toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideEmptyGroups], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideEmptyGroupsDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideEmptyGroupsToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideEmptyGroups_Changed"
                                                  Unchecked="HideEmptyGroups_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>


                        </StackPanel>

                        <!-- ══ WIFI PAGE (rules + default action + open network) ══ -->
                        <StackPanel x:Name="PageWifi" Visibility="Collapsed">

                            <!-- Rules list (top) -->
                            <TextBlock Text="{Binding [SettingsSectionRules], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <StackPanel x:Name="AutomationPanel">
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Column header bar -->
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding [RuleColName],   Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding [RuleColSsid],   Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding [RuleColAction], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding [RuleColCount],  Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding [RuleColTunnel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                                           FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Rule rows -->
                                        <ListView Grid.Row="1" x:Name="RulesListView"
                                                  MinHeight="40" MaxHeight="200"
                                                  Background="Transparent" BorderThickness="0"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  SelectionChanged="RulesListView_SelectionChanged">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Background"               Value="Transparent"/>
                                                    <Setter Property="BorderThickness"          Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding"                  Value="0"/>
                                                    <Setter Property="Margin"                   Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding RuleName}"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                   FontSize="{DynamicResource Theme.FontSize}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SsidDisplay}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ActionLabel}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ExecutionCount}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding TunnelDisplay}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="{Binding [BtnAddRule], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource SuccessBtn}" FontSize="10" Padding="10,3"
                                            Click="AddRule_Click"/>
                                    <Button Content="{Binding [BtnEditRule], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                            Margin="6,0,0,0" Click="EditRule_Click"
                                            x:Name="EditBtn" IsEnabled="False"/>
                                    <Button Content="{Binding [BtnDeleteRule], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource DangerBtn}" FontSize="10" Padding="10,3"
                                            Margin="6,0,0,0" Click="DeleteRule_Click"
                                            x:Name="DeleteBtn" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Automation settings (below rules) -->
                            <TextBlock Text="{Binding [SettingsSectionMode], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Disable WiFi rules toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsDisableWifiRulesLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsDisableWifiRulesDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ManualModeToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Checked="ManualMode_Changed" Unchecked="ManualMode_Changed"
                                                  Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <!-- WiFi Default Action (fallback when no rule matches) -->
                            <TextBlock Text="{Binding [SettingsSectionDefaultAction], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"
                                       Margin="0,16,0,4"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDefaultActionInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <RadioButton x:Name="ActionNone"
                                                 Content="{Binding [DefaultActionNone], Source={x:Static local:Lang.Instance}}"
                                                 Checked="DefaultAction_Changed" Tag="none" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="ActionDiscon"
                                                 Content="{Binding [DefaultActionDisconnect], Source={x:Static local:Lang.Instance}}"
                                                 Checked="DefaultAction_Changed" Tag="disconnect" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="ActionActivate"
                                                 Checked="DefaultAction_Changed" Tag="activate">
                                        <RadioButton.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [DefaultActionActivate], Source={x:Static local:Lang.Instance}}"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox x:Name="DefaultTunnelBox" Margin="8,0,0,0"
                                                          MinWidth="140" FontSize="11" IsEditable="True"
                                                          SelectionChanged="DefaultTunnelBox_SelectionChanged"
                                                          LostFocus="DefaultTunnelBox_LostFocus"/>
                                            </StackPanel>
                                        </RadioButton.Content>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Open network protection -->
                            <TextBlock Text="{Binding [SettingsSectionOpenWifi], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsOpenWifiInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [OpenWifiTunnel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="OpenWifiTunnelBox"
                                              MinWidth="160" FontSize="11"
                                              SelectionChanged="OpenWifiTunnel_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Display toggles -->
                            <TextBlock Text="{Binding [SettingsSectionDisplay], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- Hide WiFi rules on main window toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsHideWifiRules], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsHideWifiRulesDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="HideWifiRulesToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="HideWifiRules_Changed"
                                                  Unchecked="HideWifiRules_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Show rules column toggle -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsShowRulesColumn], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsShowRulesColumnDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ShowRulesColumnToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ShowRulesColumn_Changed"
                                                  Unchecked="ShowRulesColumn_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ APPEARANCE PAGE ══════════════════════════════ -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">

                            <!-- System theme section -->
                            <TextBlock Text="{Binding [SettingsSectionTheme], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsThemeAutoLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsThemeAutoDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SysModeLight" GroupName="SysMode" Tag="light"
                                                     Content="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="SystemMode_Changed"/>
                                        <RadioButton x:Name="SysModeDark" GroupName="SysMode" Tag="dark"
                                                     Content="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="SystemMode_Changed"/>
                                        <RadioButton x:Name="SysModeAuto" GroupName="SysMode" Tag="auto"
                                                     Content="{Binding [WizardThemeAuto], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="SystemMode_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Theme -->
                            <TextBlock Text="{Binding [SettingsThemeSectionTitle], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <ComboBox x:Name="ThemePicker" Padding="8,4"
                                          SelectionChanged="ThemePicker_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                       Margin="0,2"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>
                            <!-- Theme preview: test dark and light variant -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsThemePreviewDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" x:Name="DarkThemePreviewBtn"
                                            Content="{Binding [SettingsThemePreviewDarkBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3" Width="72"
                                            Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource TextMuted}"
                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                            Click="DarkThemePreview_Click"
                                            ToolTip="{Binding [SettingsThemePreviewDarkTip], Source={x:Static local:Lang.Instance}}"/>
                                    <Button Grid.Column="2" x:Name="LightThemePreviewBtn"
                                            Content="{Binding [SettingsThemePreviewLightBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3" Width="72"
                                            Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource TextMuted}"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Click="LightThemePreview_Click"
                                            ToolTip="{Binding [SettingsThemePreviewLightTip], Source={x:Static local:Lang.Instance}}"/>
                                </Grid>
                            </Border>

                            <!-- Theme Builder launcher -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [ThemeBuilderTitle], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [ThemeBuilderDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{Binding [ThemeBuilderOpenBtn], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Click="OpenThemeBuilder_Click"/>
                                </Grid>
                            </Border>

                            <!-- Shared-theme repository: download / update shared themes -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Shared theme repository"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Download or update shared themes from a git repository (a GitHub repo URL or a direct .zip). They install into the read-only shared_themes folder; same-named themes are overwritten, your own themes are untouched."
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="SharedThemesRepoBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                 Padding="6,4" VerticalContentAlignment="Center"
                                                 TextChanged="SharedThemesRepo_Changed"/>
                                        <Button Grid.Column="1" x:Name="DownloadThemesBtn"
                                                Content="Download" Style="{StaticResource FlatBtn}"
                                                FontSize="10" Padding="12,5" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Click="DownloadThemes_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="DownloadThemesStatus"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Font override ─────────────────────────────── -->
                            <TextBlock Text="{Binding [SettingsFontSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsFontOverrideLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsFontOverrideDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="FontOverrideToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="FontOverride_Changed"
                                                  Unchecked="FontOverride_Changed"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="FontPickerPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <!-- Font family picker -->
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SettingsFontFamilyLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="FontFamilyPicker"
                                                  IsEditable="True"
                                                  MaxDropDownHeight="220"
                                                  FontSize="11" Padding="6,4"
                                                  TextSearch.TextPath="DisplayName"
                                                  SelectionChanged="FontFamilyPicker_Changed"
                                                  LostFocus="FontFamilyPicker_LostFocus">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="{Binding FontFamily}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding [SettingsFontFamilyHint], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Live preview — between picker and slider so you see the font before sizing -->
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [SettingsFontPreviewSection], Source={x:Static local:Lang.Instance}}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="FontPreviewLabel"
                                                   Text="{Binding [SettingsFontPreviewSample], Source={x:Static local:Lang.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Font size slider + preview button -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding [SettingsFontSizeLabel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="FontSizeValueLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" Text="12 pt"/>
                                        </Grid>
                                        <!-- min────●────max  [▶ Preview] -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" x:Name="FontSizeSlider"
                                                    Minimum="8" Maximum="18" Value="12"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="2"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="FontSizeSlider_Changed"/>
                                            <Button Grid.Column="1" x:Name="FontPreviewBtn"
                                                    Content="{Binding [SettingsFontPreviewBtn], Source={x:Static local:Lang.Instance}}" FontSize="9" Padding="8,3"
                                                    Width="76"
                                                    Style="{StaticResource FlatBtn}"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    Click="FontPreview_Click"
                                                    ToolTip="Apply this font to the whole interface for 10 s"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Notifications -->
                            <TextBlock Text="{Binding [SettingsTrayPopupLabel], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsTrayPopupLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsTrayPopup], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="TrayPopupToggle"
                                                  Width="44" Height="22" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="TrayPopup_Changed" Unchecked="TrayPopup_Changed"/>
                                </Grid>
                            </Border>
                            <!-- Notification duration -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsNotifDuration], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="NotifDurationPicker"
                                              Width="80" FontSize="11" Margin="12,0,0,0"
                                              SelectionChanged="NotifDuration_Changed"/>
                                </Grid>
                            </Border>

                            <!-- Interface -->
                            <TextBlock Text="{Binding [SettingsInterfaceSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"
                                       Margin="0,16,0,4"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [SettingsShowActivityLogLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding [SettingsShowActivityLogDesc], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="ShowActivityLogToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Checked="ShowActivityLog_Changed"
                                                  Unchecked="ShowActivityLog_Changed"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══ ADVANCED PAGE (moved below History in sidebar) ══ -->
                        <StackPanel x:Name="PageAdvanced" Visibility="Collapsed">

                            <!-- Import / Export -->
                            <TextBlock Text="{Binding [SettingsImportExportSection], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsImportExportInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="{Binding [BtnExportSettings], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                        Click="ExportSettings_Click"/>
                                <Button Content="{Binding [BtnImportSettings], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                        Margin="8,0,0,0" Click="ImportSettings_Click"/>
                            </StackPanel>

                            <!-- Log level -->
                            <TextBlock Text="{Binding [SettingsSectionLog], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [SettingsLogLevel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="LogLevelPicker"
                                              MinWidth="110" FontSize="11" Padding="8,4"
                                              SelectionChanged="LogLevel_Changed"/>
                                </Grid>
                            </Border>

                            <!-- DNS leak protection (smart multi-homed name resolution) -->
                            <TextBlock Text="{Binding [SettingsSectionDnsLeak], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                    Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding [SettingsDnsLeakInfo], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Option 1: smart multi-homed name resolution -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakSmartLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakSmartDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DnsLeakStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button x:Name="DnsLeakDisableBtn"
                                                    Content="{Binding [BtnDnsLeakDisable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource SuccessBtn}" FontSize="10" Padding="12,5"
                                                    Click="DnsLeakDisable_Click"/>
                                            <Button x:Name="DnsLeakEnableBtn"
                                                    Content="{Binding [BtnDnsLeakEnable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                    Margin="6,0,0,0" Click="DnsLeakEnable_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}"
                                            Margin="0,12,0,12"/>

                                    <!-- Option 2: parallel A / AAAA queries -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakParallelLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakParallelDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="DnsParallelStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button x:Name="DnsParallelDisableBtn"
                                                    Content="{Binding [BtnDnsLeakDisable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource SuccessBtn}" FontSize="10" Padding="12,5"
                                                    Click="DnsParallelDisable_Click"/>
                                            <Button x:Name="DnsParallelEnableBtn"
                                                    Content="{Binding [BtnDnsLeakEnable], Source={x:Static local:Lang.Instance}}"
                                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,5"
                                                    Margin="6,0,0,0" Click="DnsParallelEnable_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}"
                                            Margin="0,12,0,12"/>

                                    <!-- Possible-leak alerts: independent delivery channels (all off = disabled) -->
                                    <TextBlock Text="{Binding [SettingsDnsLeakWarnLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [SettingsDnsLeakWarnDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,2,0,8"/>

                                    <!-- Channel: inline status icon (next to bandwidth) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertIcon], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="ShowDnsIndicatorToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="ShowDnsIndicator_Changed"
                                                      Unchecked="ShowDnsIndicator_Changed"/>
                                    </Grid>

                                    <!-- Channel: activity-log warning -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertLog], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="DnsLeakWarnLogToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="DnsLeakWarnLog_Changed"
                                                      Unchecked="DnsLeakWarnLog_Changed"/>
                                    </Grid>

                                    <!-- Channel: tray toast -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding [SettingsDnsLeakAlertToast], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ToggleButton Grid.Column="1" x:Name="DnsLeakWarnToastToggle"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      Checked="DnsLeakWarnToast_Changed"
                                                      Unchecked="DnsLeakWarnToast_Changed"/>
                                    </Grid>

                                    <TextBlock Text="{Binding [SettingsDnsLeakReboot], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Installation -->
                            <TextBlock Text="{Binding [SettingsSectionInstall], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="InstallStatusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="InstallPathLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <CheckBox x:Name="SuppressUpdatePromptToggle"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                  Margin="0,8,0,0"
                                                  Checked="SuppressUpdatePrompt_Changed"
                                                  Unchecked="SuppressUpdatePrompt_Changed">
                                            <CheckBox.Content>
                                                <TextBlock Text="{Binding [SettingsSuppressUpdatePrompt], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap" MaxWidth="260"/>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="InstallBtn"
                                            Style="{StaticResource FlatBtn}"
                                            FontSize="11" Padding="14,6" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="InstallBtn_Click"/>
                                </Grid>
                            </Border>

                            <!-- WireGuard client -->
                            <TextBlock x:Name="WireGuardSectionLabel"
                                       Text="{Binding [SettingsSectionWireGuard], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border x:Name="WireGuardSectionCard" Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [SettingsWireGuardDesc], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding [BtnOpenWireGuard], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,6"
                                                Click="OpenWireGuard_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Orphaned services -->
                            <TextBlock Text="{Binding [SettingsSectionOrphans], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <!-- Warning banner -->
                                    <Border Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource WarningColor}"
                                            BorderThickness="1" CornerRadius="3"
                                            Padding="10,7" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚠  "
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource WarningColor}" VerticalAlignment="Top"
                                                       Margin="0,0,2,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding [OrphansDescription], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                       Foreground="{DynamicResource WarningColor}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- Status + scan button -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OrphanStatusLabel"
                                                   Grid.Column="0"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding [BtnScanOrphans], Source={x:Static local:Lang.Instance}}"
                                                Style="{StaticResource FlatBtn}"
                                                FontSize="10" Padding="12,4" Margin="8,0,0,0"
                                                Click="ScanOrphans_Click"/>
                                    </Grid>

                                    <!-- Orphan list (hidden when empty) -->
                                    <StackPanel x:Name="OrphanListPanel" Visibility="Collapsed"
                                                Margin="0,4,0,8"/>

                                    <!-- Remove all -->
                                    <Button x:Name="RemoveAllOrphansBtn"
                                            Content="{Binding [BtnRemoveAllOrphans], Source={x:Static local:Lang.Instance}}"
                                            Style="{StaticResource DangerBtn}"
                                            FontSize="10" Padding="12,5"
                                            HorizontalAlignment="Right"
                                            Visibility="Collapsed"
                                            Click="RemoveAllOrphans_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ HISTORY PAGE ════════════════════════════════════ -->
                        <StackPanel x:Name="PageHistory" Visibility="Collapsed">

                            <!-- Capture & Show -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ── Capture column ── -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [HistoryCaptureLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0,0,0,10"/>
                                        <!-- Capture connections -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryCaptureConnectionsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryCaptureConnectionsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="StoreConnectionHistoryToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="StoreConnectionHistory_Changed"
                                                          Unchecked="StoreConnectionHistory_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Capture WiFi -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryCaptureWifiLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryCaptureWifiDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="StoreWifiHistoryToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="StoreWifiHistory_Changed"
                                                          Unchecked="StoreWifiHistory_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Rectangle Grid.Column="1" Width="1" Margin="12,0"
                                               Fill="{DynamicResource BorderColor}" VerticalAlignment="Stretch"/>

                                    <!-- ── Show column ── -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [HistoryShowLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0,0,0,10"/>
                                        <!-- Show connections -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryShowConnectionsLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryShowConnectionsDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="ShowTimelineToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="ShowTimeline_Changed"
                                                          Unchecked="ShowTimeline_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                        <!-- Show WiFi -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding [HistoryShowWifiLabel], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding [HistoryShowWifiDesc], Source={x:Static local:Lang.Instance}}"
                                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="8"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="ShowWifiInChartToggle"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Checked="ShowWifiInChart_Changed"
                                                          Unchecked="ShowWifiInChart_Changed"
                                                          VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Activity chart options -->
                            <TextBlock Text="{Binding [HistoryActivityChartTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding [HistoryTimeRangeLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="ChartRange24h"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange24h], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Margin="0,0,16,0"
                                                     Checked="InfoTimeRange_Changed"/>
                                        <RadioButton x:Name="ChartRange7d"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange7d], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Margin="0,0,16,0"
                                                     Checked="InfoTimeRange_Changed"/>
                                        <RadioButton x:Name="ChartRange31d"
                                                     GroupName="InfoTimeRange"
                                                     Content="{Binding [HistoryRange31d], Source={x:Static local:Lang.Instance}}"
                                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Checked="InfoTimeRange_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [HistorySectionTitle], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>

                            <!-- List -->
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column header bar -->
                                    <Border Grid.Row="0"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,5,8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding [HistoryColTunnel], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding [HistoryColDuration], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding [HistoryColSource], Source={x:Static local:Lang.Instance}}"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </Border>

                                    <!-- History rows -->
                                    <ListView Grid.Row="1" x:Name="HistoryList"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Height="306"
                                              FontFamily="{DynamicResource Theme.FontFamily}"
                                              FontSize="{DynamicResource Theme.FontSize.Small}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background"                  Value="Transparent"/>
                                                <Setter Property="BorderThickness"             Value="0"/>
                                                <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
                                                <Setter Property="Padding"                     Value="0"/>
                                                <Setter Property="Margin"                      Value="0"/>
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                                                <Setter Property="ToolTipService.ShowDuration"     Value="15000"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderThickness="0" CornerRadius="4">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ToolTip">
                                                    <Setter.Value>
                                                        <ToolTip Background="Transparent" BorderThickness="0"
                                                                 Padding="0" HasDropShadow="False"
                                                                 DataContext="{Binding Path=PlacementTarget.DataContext,
                                                                               RelativeSource={RelativeSource Self}}">
                                                            <Border Background="{DynamicResource Surface}"
                                                                    BorderBrush="{DynamicResource BorderColor}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Theme.CornerRadius}"
                                                                    Padding="12,10,16,10"
                                                                    MinWidth="240">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="Black" Opacity="0.4"
                                                                                      BlurRadius="12" ShadowDepth="3"
                                                                                      Direction="270"/>
                                                                </Border.Effect>
                                                                <StackPanel>
                                                                    <!-- Tunnel name header -->
                                                                    <TextBlock Text="{Binding TunnelName}"
                                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                                               FontSize="12" FontWeight="Bold"
                                                                               Foreground="{DynamicResource Accent}"
                                                                               Margin="0,0,0,8"/>
                                                                    <!-- Connected at -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupConnected], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding FullWhenDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Time range -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupPeriod], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding TimeRangeDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Duration -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupDuration], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DurationDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Traffic -->
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryPopupTraffic], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding TrafficDisplay}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                                    </Grid>
                                                                    <!-- Via / trigger -->
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding [HistoryColSource], Source={x:Static local:Lang.Instance}}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Source}"
                                                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                                                   FontSize="10" Foreground="{DynamicResource TextPrimary}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TunnelName}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DurationDisplay}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Source}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <!-- Clear button -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding [HistoryClearBtn], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource DangerBtn}" FontSize="10" Padding="10,3"
                                        Click="ClearHistory_Click"/>
                                <TextBlock x:Name="HistoryCountLabel"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- ══ ABOUT PAGE ══════════════════════════════════════ -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">

                            <!-- Updates -->
                            <TextBlock Text="{Binding [SettingsSectionUpdate], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Version + status badge row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="VersionLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="BuildLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,1,0,0"/>
                                            <TextBlock x:Name="LastCheckedLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <!-- Status badge pill -->
                                        <Border Grid.Column="1" x:Name="UpdateStatusBadge"
                                                CornerRadius="10" Padding="10,4"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="UpdateStatusLabel"
                                                       FontFamily="{DynamicResource Theme.FontFamily}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Separator -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                                    <!-- Frequency pills row -->
                                    <TextBlock Text="{Binding [UpdateCheckFrequencyLabel], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="FreqOnStart" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckOnStart], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}"
                                                     Checked="UpdateFreq_Changed" Tag="onstart"/>
                                        <RadioButton x:Name="FreqDaily" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckDaily], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="daily"/>
                                        <RadioButton x:Name="FreqWeekly" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckWeekly], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="weekly"/>
                                        <RadioButton x:Name="FreqManual" GroupName="UpdateFreq"
                                                     Content="{Binding [UpdateCheckManual], Source={x:Static local:Lang.Instance}}"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                     Checked="UpdateFreq_Changed" Tag="manual"/>
                                    </StackPanel>

                                    <!-- Action buttons row -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateBtn"
                                                Style="{StaticResource FlatBtn}"
                                                FontSize="10" Padding="12,6"
                                                Click="CheckUpdate_Click"/>
                                        <Button x:Name="DoUpdateBtn"
                                                Style="{StaticResource SuccessBtn}"
                                                FontSize="10" Padding="12,6" Margin="8,0,0,0"
                                                Visibility="Collapsed"
                                                Click="DoUpdate_Click"/>
                                    </StackPanel>

                                    <!-- Download / extract / apply progress -->
                                    <TextBlock x:Name="UpdateProgressLabel"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource Accent}"
                                               Margin="0,8,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>

                                </StackPanel>
                            </Border>

                            <!-- MasselGUARD -->
                            <TextBlock Text="MasselGUARD"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="by Harold Masselink"
                                               FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="GithubLink"
                                               Text="github.com/masselink/MasselGUARD"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                               Foreground="{DynamicResource Accent}"
                                               Cursor="Hand" TextDecorations="Underline"
                                               Margin="0,4,0,0"
                                               MouseLeftButtonUp="GithubLink_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- What's New -->
                            <TextBlock Text="What's New"
                                       Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid Height="220">

                                    <!-- Success state: rendered markdown -->
                                    <RichTextBox x:Name="WhatsNewBox"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 FontFamily="{DynamicResource Theme.FontFamily}"
                                                 FontSize="10"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Visibility="Collapsed"
                                                 Padding="0"/>

                                    <!-- Error state: shown when GitHub is unreachable -->
                                    <StackPanel x:Name="WhatsNewErrorPanel"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🌐"
                                                   FontSize="30"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Could not load release notes."
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,18"/>
                                        <TextBlock Text="github.com/masselink/MasselGUARD"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextDecorations="Underline"
                                                   Cursor="Hand"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"
                                                   MouseLeftButtonUp="WhatsNewLink_GitHub_Click"/>
                                        <TextBlock Text="masselink.net"
                                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextDecorations="Underline"
                                                   Cursor="Hand"
                                                   HorizontalAlignment="Center"
                                                   MouseLeftButtonUp="WhatsNewLink_Site_Click"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="{Binding [BtnCancel], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Padding="20,6" Margin="0,0,8,0"
                            Click="CloseBtn_Click"/>
                    <Button x:Name="SaveBtn"
                            Content="{Binding [BtnSaveSettings], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource SuccessBtn}" Padding="20,6"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
