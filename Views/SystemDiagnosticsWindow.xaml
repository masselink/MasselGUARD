<Window x:Class="MasselGUARD.Views.SystemDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [SysDiagTitle], Source={x:Static local:Lang.Instance}}"
        Width="760" Height="680"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="{Binding [SysDiagTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="&#x2715;" Style="{StaticResource DangerBtn}"
                            HorizontalAlignment="Right" Padding="10,4" Margin="0,0,8,0"
                            BorderThickness="0" Background="Transparent"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Report body (built in code-behind) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                <StackPanel x:Name="ReportHost"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="16,10">
                    <Button x:Name="CopyBtn"
                            Content="{Binding [BtnCopyAll], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Padding="14,6" Margin="0,0,8,0"
                            Click="CopyBtn_Click"/>
                    <Button x:Name="RefreshBtn"
                            Content="{Binding [BtnRefresh], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Padding="14,6" Margin="0,0,8,0"
                            Click="RefreshBtn_Click"/>
                    <Button Content="{Binding [BtnClose], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource PrimaryBtn}" Padding="20,6"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
