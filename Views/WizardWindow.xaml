<Window x:Class="MasselGUARD.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [WizardTitle], Source={x:Static local:Lang.Instance}}"
        Width="520" Height="520"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="{Binding [WizardTitle], Source={x:Static local:Lang.Instance}}"
                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="16,0"/>
            </Border>

            <!-- Step dots: 9 steps (0-8) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,14,0,0">
                <Ellipse x:Name="Dot0" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource Accent}"/>
                <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot2" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot3" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot4" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot5" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot6" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot7" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                <Ellipse x:Name="Dot8" Width="10" Height="10" Margin="4,0" Fill="{DynamicResource BorderColor}"/>
            </StackPanel>

            <!-- Step pages -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,20,32,0">

                <!-- ── Step 0: Welcome + import + language ─────────────────────── -->
                <StackPanel x:Name="Step0">
                    <TextBlock Text="{Binding [WizardWelcomeTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>

                    <Border x:Name="WizUpgradeNotice" Visibility="Collapsed"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0"
                            Padding="12,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="WizUpgradeTitle"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="WizUpgradeBody"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [WizardWelcomeBody], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                    <!-- Language -->
                    <TextBlock Text="{Binding [SettingsLanguageLabel], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="WizLangPicker" FontSize="11"
                              SelectionChanged="WizLang_Changed" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding FlagImage}" Width="20" Height="14"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Import settings card -->
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.CornerRadius}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [WizardImportHint], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="WizImportResultLabel"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                           Foreground="{DynamicResource Success}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding [WizardImportBtn], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,5"
                                    Margin="12,0,0,0" VerticalAlignment="Center" Click="WizImport_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 1: Feature choice (VPN / DNS / Both) ───────────────── -->
                <StackPanel x:Name="Step1" Visibility="Collapsed">
                    <TextBlock Text="{Binding [WizFeatureTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizFeatureDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Ask per feature (matches General → Features). Each card: title + what it does
                         + an enable toggle. Activity log adds a Normal/Debug level; History adds the
                         chart layers (greyed when their feature isn't available). -->

                    <!-- WireGuard -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizFeatureVpnTitle], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizFeatureVpnDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizFeatWgToggle" Style="{StaticResource ToggleSwitch}" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Checked="WizFeatWg_Changed" Unchecked="WizFeatWg_Changed"/>
                        </Grid>
                    </Border>

                    <!-- DNS -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizFeatureDnsTitle], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizFeatureDnsDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizFeatDnsToggle" Style="{StaticResource ToggleSwitch}" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Checked="WizFeatDns_Changed" Unchecked="WizFeatDns_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Automation -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SettingsTabAutomation], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [FeatAutoDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizFeatAutoToggle" Style="{StaticResource ToggleSwitch}" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Checked="WizFeatAuto_Changed" Unchecked="WizFeatAuto_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Activity log + level -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [ActivityLogHeader], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [FeatLogDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="WizFeatLogToggle" Style="{StaticResource ToggleSwitch}" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Checked="WizFeatLog_Changed" Unchecked="WizFeatLog_Changed"/>
                            </Grid>
                            <StackPanel x:Name="WizLogLevelRow" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding [WizLogDetailLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton x:Name="WizLogNormal" GroupName="WizLogLevel" Content="{Binding [WizLogNormalLabel], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Checked="WizLogLevel_Changed"/>
                                <RadioButton x:Name="WizLogDebug" GroupName="WizLogLevel" Content="{Binding [WizLogDebugLabel], Source={x:Static local:Lang.Instance}}" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="WizLogLevel_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- History (charts) + layers -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [WizHistoryTitle], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding [FeatChartsDesc], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="WizFeatChartsToggle" Style="{StaticResource ToggleSwitch}" Width="44" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Checked="WizFeatCharts_Changed" Unchecked="WizFeatCharts_Changed"/>
                            </Grid>
                            <StackPanel x:Name="WizChartLayersRow" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding [WizChartShowLabel], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="WizPaneTimeline" Content="{Binding [WizPaneTimelineLabel], Source={x:Static local:Lang.Instance}}" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" Checked="WizPane_Changed" Unchecked="WizPane_Changed"/>
                                <CheckBox x:Name="WizPaneUsage" Content="{Binding [WizPaneUsageLabel], Source={x:Static local:Lang.Instance}}" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0" Checked="WizPane_Changed" Unchecked="WizPane_Changed"/>
                                <CheckBox x:Name="WizPaneDns" Content="{Binding [WizPaneDnsLabel], Source={x:Static local:Lang.Instance}}" FontSize="10" Foreground="{DynamicResource TextPrimary}" Checked="WizPane_Changed" Unchecked="WizPane_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Step 2: Appearance ──────────────────────────────────────── -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="{Binding [SettingsTabAppearance], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizAppearanceDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding [WizardThemeLabel], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WizThemeDark"
                                     Content="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}"
                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Margin="0,0,20,0" GroupName="WizTheme" Checked="WizTheme_Changed"/>
                        <RadioButton x:Name="WizThemeLight"
                                     Content="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}"
                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Margin="0,0,20,0" GroupName="WizTheme" Checked="WizTheme_Changed"/>
                        <RadioButton x:Name="WizThemeAuto"
                                     Content="{Binding [WizardThemeAuto], Source={x:Static local:Lang.Instance}}"
                                     FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                     Foreground="{DynamicResource TextPrimary}"
                                     GroupName="WizTheme" Checked="WizTheme_Changed"/>
                    </StackPanel>

                    <TextBlock Text="{Binding [SettingsThemeSectionTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" Margin="0,16,0,4"/>
                    <ComboBox x:Name="WizThemePicker" FontSize="11" Padding="8,4"
                              SelectionChanged="WizThemePicker_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                           FontSize="11" Foreground="{DynamicResource TextPrimary}" Margin="0,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{Binding [WizDownloadThemes], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,5"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Click="WizDownloadThemes_Click" ToolTip="{Binding [WizDownloadThemesTip], Source={x:Static local:Lang.Instance}}"/>

                    <TextBlock Text="{Binding [WizTbChartsBtnHdr], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,16,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbShowCharts], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbChartDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizShowChartsBtnToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizShowChartsBtn_Changed" Unchecked="WizShowChartsBtn_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbShowLog], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbMenuDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizShowLogBtnToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizShowLogBtn_Changed" Unchecked="WizShowLogBtn_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 3: Startup ─────────────────────────────────────────── -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="{Binding [SettingsTabStartup], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizStartupDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border x:Name="WizInstallChoice" Visibility="Collapsed"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.CornerRadius}" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [WizardInstallQuestion], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding [WizardInstallPortable], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="11" Padding="12,6"
                                        Margin="0,0,8,0" Click="WizRunPortable_Click"/>
                                <Button Content="{Binding [WizardInstallManaged], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource SuccessBtn}" FontSize="11" Padding="12,6"
                                        Click="WizInstallNow_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Start with Windows -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SettingsStartWithWindows], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [SettingsStartWithWindowsDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizStartWithWindowsToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizStartWithWindows_Changed" Unchecked="WizStartWithWindows_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Start minimized -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizStartMinTitle], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizStartMinDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizStartMinimizedToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizStartMinimized_Changed" Unchecked="WizStartMinimized_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Confirm on exit -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SettingsConfirmOnExit], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizConfirmExitDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizConfirmOnCloseToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizConfirmOnClose_Changed" Unchecked="WizConfirmOnClose_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 4: WiFi settings ───────────────────────────────────── -->
                <StackPanel x:Name="Step4" Visibility="Collapsed">
                    <TextBlock Text="{Binding [SettingsTabWifi], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizardManualBody], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0"
                            Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [WizardRulesTitle], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding [WizardRulesBody], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Disable WiFi automation -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [WizardDisableRulesLabel], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleButton Grid.Column="1" x:Name="WizManualToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizManualToggle_Changed" Unchecked="WizManualToggle_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Show WiFi rules on main window -->
                    <Border x:Name="WizShowRulesCard"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizardShowRulesLabel], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizardShowRulesDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizShowRulesToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="True" Margin="12,0,0,0"
                                          Checked="WizShowRules_Changed" Unchecked="WizShowRules_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [WizTbWifiBtnHdr], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [WizTbShowWifi], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="WizShowWifiBtnToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizShowWifiBtn_Changed" Unchecked="WizShowWifiBtn_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbDisWifi], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbDisWifiDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizWifiDisableToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizWifiDisable_Changed" Unchecked="WizWifiDisable_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 5: WireGuard Behaviour ─────────────────────────────── -->
                <StackPanel x:Name="Step5" Visibility="Collapsed">
                    <TextBlock Text="{Binding [WizWgTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizWgDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding [SettingsAutoReconnectModeTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [WizArDesc], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WizArOff" GroupName="WizAr" Tag="off" Content="{Binding [SettingsModeOff], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Checked="WizArMode_Changed"/>
                                <RadioButton x:Name="WizArPerTunnel" GroupName="WizAr" Tag="per-tunnel" Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="WizArMode_Changed"/>
                                <RadioButton x:Name="WizArAlways" GroupName="WizAr" Tag="always" Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="WizArMode_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [WizKsTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [WizKsDesc], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="WizKsOff" GroupName="WizKs" Tag="off" Content="{Binding [SettingsModeOff], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Checked="WizKsMode_Changed"/>
                                <RadioButton x:Name="WizKsPerTunnel" GroupName="WizKs" Tag="per-tunnel" Content="{Binding [SettingsModePerTunnel], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="WizKsMode_Changed"/>
                                <RadioButton x:Name="WizKsAlways" GroupName="WizKs" Tag="always" Content="{Binding [SettingsModeAlways], Source={x:Static local:Lang.Instance}}"
                                             Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="WizKsMode_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DNS leak indicator -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [ShowDnsIndicatorLabel], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [ShowDnsIndicatorDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizDnsIndicatorToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizDnsIndicator_Changed" Unchecked="WizDnsIndicator_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [WizTbTunnelsBtnHdr], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbShowTunnels], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbShieldDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizShowTunnelBtnToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizShowTunnelBtn_Changed" Unchecked="WizShowTunnelBtn_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbDisTunnels], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbDisTunnelsDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizTunnelDisableToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizTunnelDisable_Changed" Unchecked="WizTunnelDisable_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 6: DNS Profiles Behaviour ──────────────────────────── -->
                <StackPanel x:Name="Step6" Visibility="Collapsed">
                    <TextBlock Text="{Binding [SettingsSectionDns], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizDnsDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0"
                            Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [WizDnsHowTitle], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="{Binding [WizDnsHowDesc], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SettingsDnsEnableLabel], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizDnsEnableDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizDnsAutomationToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizDnsAutomation_Changed" Unchecked="WizDnsAutomation_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [WizTbDnsBtnHdr], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbShowDns], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbGlobeDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizShowDnsBtnToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizShowDnsBtn_Changed" Unchecked="WizShowDnsBtn_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizTbDisDns], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizTbDisDnsDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizDnsDisableToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizDnsDisable_Changed" Unchecked="WizDnsDisable_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 7: Notifications & history ─────────────────────────── -->
                <StackPanel x:Name="Step7" Visibility="Collapsed">
                    <TextBlock Text="{Binding [SettingsTabNotifHistory], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizNotifDesc], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [SettingsTrayPopupLabel], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [SettingsTrayPopup], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizTrayPopupToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizTrayPopup_Changed" Unchecked="WizTrayPopup_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Notification duration -->
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [WizNotifDuration], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="WizNotifDurationBox" Width="70" FontSize="11" Padding="6,4"
                                     VerticalAlignment="Center" LostFocus="WizNotifDuration_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding [WizHistoryTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [WizRecTunnels], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="WizStoreConnectionHistoryToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizStoreConnectionHistory_Changed" Unchecked="WizStoreConnectionHistory_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding [WizRecWifi], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="WizStoreWifiHistoryToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizStoreWifiHistory_Changed" Unchecked="WizStoreWifiHistory_Changed"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [WizRecDns], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding [WizRecDnsDesc], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="WizStoreDnsHistoryToggle"
                                          Width="44" Height="22" Style="{StaticResource ToggleSwitch}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="WizStoreDnsHistory_Changed" Unchecked="WizStoreDnsHistory_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ── Step 8: Done ────────────────────────────────────────────── -->
                <StackPanel x:Name="Step8" Visibility="Collapsed">
                    <TextBlock Text="{Binding [WizardDoneTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding [WizardDoneBody], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WizVersionLabel" Grid.Column="0"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            <Button x:Name="WizCheckUpdateBtn" Grid.Column="1"
                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,4"
                                    Margin="12,0,0,0" Click="WizCheckUpdate_Click"/>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel x:Name="WizSummaryPanel"/>
                    </Border>

                    <Border Background="{DynamicResource Surface}" CornerRadius="4" Padding="12,8">
                        <TextBlock Text="{Binding [WizardDoneTip], Source={x:Static local:Lang.Instance}}"
                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </Grid>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="3" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <Grid Margin="16,0">
                    <Button x:Name="BtnSkip" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Content="{Binding [WizardBtnSkip], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Padding="14,6" FontSize="11" Click="BtnSkip_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnBack"
                                Content="{Binding [WizardBtnBack], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource FlatBtn}" Padding="14,6" FontSize="11"
                                IsEnabled="False" Margin="0,0,8,0" Click="BtnBack_Click"/>
                        <Button x:Name="BtnNext"
                                Content="{Binding [WizardBtnNext], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource SuccessBtn}" Padding="20,6" FontSize="11" Click="BtnNext_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
