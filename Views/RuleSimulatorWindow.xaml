<Window x:Class="MasselGUARD.Views.RuleSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Width="700" Height="720" MinWidth="560" MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBg}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="{Binding [TestAdvTitle], Source={x:Static local:Lang.Instance}}"
                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"
                           Margin="16,0" VerticalAlignment="Center"/>
            </Border>

            <!-- The network to test -->
            <StackPanel Grid.Row="1" Margin="20,14,20,8">
                <TextBlock Text="{Binding [TestAdvIntro], Source={x:Static local:Lang.Instance}}"
                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [TestAdvKind], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <ComboBox x:Name="KindBox" Width="160" SelectionChanged="Kind_Changed"/>
                        <CheckBox x:Name="OpenCheck" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Content="{Binding [TestAdvOpen], Source={x:Static local:Lang.Instance}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [DiagSsid], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SsidBox" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [DiagDnsSuffix], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="SuffixBox" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [DiagGatewayMac], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="MacBox" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [DiagSubnets], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SubnetsBox" Margin="0,0,0,6"
                             ToolTip="{Binding [RuleMatchValueSubnet], Source={x:Static local:Lang.Instance}}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="FetchBtn" Style="{StaticResource FlatBtn}" FontSize="10" Padding="12,6"
                            Content="{Binding [TestAdvFetch], Source={x:Static local:Lang.Instance}}"
                            ToolTip="{Binding [RuleFetchTip], Source={x:Static local:Lang.Instance}}"
                            Click="Fetch_Click"/>
                    <Button x:Name="RunBtn" Style="{StaticResource PrimaryBtn}" FontSize="10" Padding="14,6" Margin="8,0,0,0"
                            Content="{Binding [TestAdvRun], Source={x:Static local:Lang.Instance}}"
                            Click="Run_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Reasoning / activity panel -->
            <Grid Grid.Row="2" Margin="20,4,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding [TestAdvReasoning], Source={x:Static local:Lang.Instance}}"
                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                <Border Grid.Row="1" Background="{DynamicResource WindowBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.CornerRadius}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                        <StackPanel x:Name="StepsHost"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="3" Background="{DynamicResource WindowBg}" CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,8,16,8" VerticalAlignment="Center">
                    <Button Content="{Binding [BtnClose], Source={x:Static local:Lang.Instance}}"
                            Style="{StaticResource FlatBtn}" Click="Close_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
