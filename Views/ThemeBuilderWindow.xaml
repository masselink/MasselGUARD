<Window x:Class="MasselGUARD.Views.ThemeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [TBTitle], Source={x:Static local:Lang.Instance}}"
        Width="840" Height="660"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        Opacity="{DynamicResource Theme.WindowOpacity}"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusTop}"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock Text="{Binding [TBTitle], Source={x:Static local:Lang.Instance}}"
                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="16,0"/>
                    <Button Content="&#x2715;" Style="{StaticResource DangerBtn}"
                            HorizontalAlignment="Right" Padding="10,4" Margin="0,0,8,0"
                            BorderThickness="0" Background="Transparent"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Body: left sidebar + right editor -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left: Theme list ── -->
                <Border Grid.Column="0" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Add theme (create / download / import) -->
                        <Button Grid.Row="0" Content="+ Add theme"
                                Style="{StaticResource FlatBtn}"
                                HorizontalAlignment="Stretch" Margin="8,8,8,4"
                                Click="AddTheme_Click"
                                ToolTip="{Binding [TBNewTip], Source={x:Static local:Lang.Instance}}"/>

                        <!-- Community themes (browse / install from the repository) -->
                        <Button Grid.Row="1" Content="{Binding [TBCommunityThemes], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource FlatBtn}"
                                HorizontalAlignment="Stretch" Margin="8,0,8,4"
                                Click="DownloadThemes_Click"
                                ToolTip="{Binding [TBCommunityTip], Source={x:Static local:Lang.Instance}}"/>

                        <!-- Theme list -->
                        <ScrollViewer Grid.Row="2" x:Name="ThemeListScroll" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ThemeListScroll_PreviewMouseWheel">
                            <StackPanel>
                                <!-- Built-in header -->
                                <TextBlock Text="{Binding [TBBuiltIn], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="12,8,8,4"/>
                                <ListBox x:Name="BuiltinList"
                                         Background="Transparent" BorderThickness="0"
                                         SelectionChanged="ThemeList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThemeItem_RightClick"/>
                                            <Setter Property="Background"  Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding"     Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Themes header -->
                                <TextBlock Text="{Binding [TBThemesHeader], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="12,10,8,4"/>
                                <ListBox x:Name="CustomList"
                                         Background="Transparent" BorderThickness="0"
                                         SelectionChanged="ThemeList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThemeItem_RightClick"/>
                                            <Setter Property="Background"  Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding"     Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Custom themes header — themes whose JSON file doesn't follow the
                                     app's own "theme.json" naming (community-repo "<id>-theme.json"
                                     distribution files, or anything copied in by hand). Collapsed
                                     when empty. -->
                                <TextBlock x:Name="CustomNamedHeader" Text="{Binding [TBCustomThemes], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="12,10,8,4" Visibility="Collapsed"
                                           ToolTip="{Binding [TBCustomThemesTip], Source={x:Static local:Lang.Instance}}"/>
                                <ListBox x:Name="CustomNamedList"
                                         Background="Transparent" BorderThickness="0"
                                         SelectionChanged="ThemeList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThemeItem_RightClick"/>
                                            <Setter Property="Background"  Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding"     Value="10,5"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Empty state -->
                                <TextBlock x:Name="NoCustomLabel"
                                           Text="{Binding [TBNoThemes], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}"
                                           FontSize="9" Foreground="{DynamicResource TextMuted}"
                                           Margin="12,0,8,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Hints: right-click a theme + hold-Shift fallback -->
                        <StackPanel Grid.Row="3" Margin="12,4,8,8">
                            <TextBlock Text="{Binding [TBRightClickHint], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding [TBShiftHint], Source={x:Static local:Lang.Instance}}"
                                       FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Right: Editor ── -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">

                        <!-- Empty state -->
                        <TextBlock x:Name="EmptyStateLabel"
                                   Text="{Binding [TBSelectPrompt], Source={x:Static local:Lang.Instance}}"
                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,60,0,0"/>

                        <!-- Editor (hidden until theme selected) -->
                        <StackPanel x:Name="EditorPanel" Visibility="Collapsed">

                            <!-- Read-only notice -->
                            <Border x:Name="ReadOnlyBanner" Visibility="Collapsed"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0"
                                    Padding="12,8" Margin="0,0,0,12">
                                <TextBlock Text="{Binding [TBSystemReadonly], Source={x:Static local:Lang.Instance}}"
                                           FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- ── Identity ──────────────────────────────────── -->
                            <TextBlock Text="{Binding [TBSecIdentity], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Name -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBThemeName], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="ThemeName"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                    </Grid>

                                    <!-- App name -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBAppName], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AppNameBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                    </Grid>

                                    <!-- Creator -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBCreator], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="CreatorBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                    </Grid>

                                    <!-- Description -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBDescription], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top"
                                                   Margin="0,4,0,0"/>
                                        <TextBox Grid.Column="1" x:Name="DescriptionBox"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="11"
                                                 Padding="6,4" TextWrapping="Wrap" AcceptsReturn="False"
                                                 MaxLength="150" TextChanged="Field_Changed"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── Colors ─────────────────────────────────────── -->
                            <TextBlock Text="{Binding [TBSecColors], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Variant selector: which colour set is edited;
                                         the app shows the selected variant live -->
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="VariantDark" Content="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}"
                                                             GroupName="EditVariant" IsChecked="True"
                                                             Style="{StaticResource PillRadio}"
                                                             Checked="Variant_Changed"/>
                                                <RadioButton x:Name="VariantLight" Content="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}"
                                                             GroupName="EditVariant"
                                                             Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                                             Checked="Variant_Changed"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <CheckBox x:Name="InvertCopyCheck" Content="{Binding [TBInvertCopy], Source={x:Static local:Lang.Instance}}"
                                                          FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                          Foreground="{DynamicResource TextMuted}"
                                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                                          Checked="InvertCopy_Changed" Unchecked="InvertCopy_Changed"
                                                          ToolTip="{Binding [TBInvertCopyTip], Source={x:Static local:Lang.Instance}}"/>
                                                <Button x:Name="CopyAllLightBtn" Content="{Binding [TBCopyAllLight], Source={x:Static local:Lang.Instance}}"
                                                        Style="{StaticResource FlatBtn}" FontSize="9" Padding="8,3"
                                                        Click="CopyAllToLight_Click"
                                                        ToolTip="{Binding [TBCopyAllLightTip], Source={x:Static local:Lang.Instance}}"/>
                                                <Button x:Name="CopyAllDarkBtn" Content="{Binding [TBCopyAllDark], Source={x:Static local:Lang.Instance}}"
                                                        Style="{StaticResource FlatBtn}" FontSize="9" Padding="8,3"
                                                        Margin="6,0,0,0"
                                                        Click="CopyAllToDark_Click"
                                                        ToolTip="{Binding [TBCopyAllDarkTip], Source={x:Static local:Lang.Instance}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="EmptySlotsOnlyCheck" Content="{Binding [TBEmptySlotsOnly], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  HorizontalAlignment="Right" Margin="0,6,0,0"
                                                  ToolTip="{Binding [TBEmptySlotsOnlyTip], Source={x:Static local:Lang.Instance}}"/>
                                    </StackPanel>
                                    <!-- Color rows are built in code-behind and added here -->
                                    <StackPanel x:Name="ColorsPanel"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Typography ─────────────────────────────────── -->
                            <TextBlock Text="{Binding [TBSecTypography], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Font family -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBFontFamily], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="FontFamilyBox"
                                                  IsEditable="True" FontSize="11" Padding="6,4"
                                                  MaxDropDownHeight="260"
                                                  TextSearch.TextPath="Source"
                                                  SelectionChanged="FontFamily_Changed"
                                                  LostFocus="FontFamily_LostFocus">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Each entry renders in its own typeface -->
                                                    <TextBlock Text="{Binding Source}"
                                                               FontFamily="{Binding}"
                                                               FontSize="13"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Header font family (title bar + section headers) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBHeaderFont], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="HeaderFontFamilyBox"
                                                  IsEditable="True" FontSize="11" Padding="6,4"
                                                  MaxDropDownHeight="260"
                                                  TextSearch.TextPath="Source"
                                                  ToolTip="{Binding [TBHeaderFontTip], Source={x:Static local:Lang.Instance}}"
                                                  SelectionChanged="HeaderFontFamily_Changed"
                                                  LostFocus="HeaderFontFamily_LostFocus">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Each entry renders in its own typeface -->
                                                    <TextBlock Text="{Binding Source}"
                                                               FontFamily="{Binding}"
                                                               FontSize="13"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Font size -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [SettingsFontSizeLabel], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="FontSizeSlider"
                                                Minimum="9" Maximum="18" TickFrequency="1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="FontSize_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="FontSizeLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Corner radius -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBCornerRadius], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="CornerRadiusSlider"
                                                Minimum="0" Maximum="16" TickFrequency="1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="CornerRadius_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="CornerRadiusLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── Transparency ───────────────────────────────── -->
                            <TextBlock Text="{Binding [TBSecTransparency], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Opacity -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBAppTransparency], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [TBAppTransparencyTip], Source={x:Static local:Lang.Instance}}"/>
                                        <Slider Grid.Column="1" x:Name="OpacitySlider"
                                                Minimum="0.1" Maximum="1.0" SmallChange="0.05"
                                                VerticalAlignment="Center"
                                                ValueChanged="Opacity_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="OpacityLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Panel opacity (Surface/Card transparency over the bg image) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBPanelTransparency], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [TBPanelTransparencyTip], Source={x:Static local:Lang.Instance}}"/>
                                        <Slider Grid.Column="1" x:Name="PanelOpacitySlider"
                                                Minimum="0.2" Maximum="1.0" SmallChange="0.05"
                                                VerticalAlignment="Center"
                                                ValueChanged="PanelOpacity_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="PanelOpacityLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Per-colour transparency (alpha channel baked into that colour's hex) -->
                                    <TextBlock Text="{Binding [TBColourTransparency], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,4,0,8"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBColListHover], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [TBListHoverAlphaTip], Source={x:Static local:Lang.Instance}}"/>
                                        <Slider Grid.Column="1" x:Name="ListHoverAlphaSlider" Tag="ColorListHover"
                                                Minimum="0" Maximum="1.0" SmallChange="0.05"
                                                VerticalAlignment="Center"
                                                ValueChanged="ColorAlpha_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="ListHoverAlphaLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBColTrayHover], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [TBTrayHoverAlphaTip], Source={x:Static local:Lang.Instance}}"/>
                                        <Slider Grid.Column="1" x:Name="TrayHoverAlphaSlider" Tag="ColorTrayHover"
                                                Minimum="0" Maximum="1.0" SmallChange="0.05"
                                                VerticalAlignment="Center"
                                                ValueChanged="ColorAlpha_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="TrayHoverAlphaLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBHighlightOverlay], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                                   ToolTip="{Binding [TBHighlightAlphaTip], Source={x:Static local:Lang.Instance}}"/>
                                        <Slider Grid.Column="1" x:Name="HighlightAlphaSlider" Tag="ColorHighlight"
                                                Minimum="0" Maximum="1.0" SmallChange="0.05"
                                                VerticalAlignment="Center"
                                                ValueChanged="ColorAlpha_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="HighlightAlphaLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── Window (header + status bar) ───────────────── -->
                            <TextBlock Text="{Binding [TBSecWindow], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Title bar height -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBTitleBarHeight], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="TitleBarHeightSlider"
                                                Minimum="32" Maximum="72" TickFrequency="1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="TitleBarHeight_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="TitleBarHeightLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Header toggles -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <CheckBox x:Name="ShowTitleBarIconCheck" Content="{Binding [TBTitleBarIcon], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                  Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        <CheckBox x:Name="ShowTitleBarAppNameCheck" Content="{Binding [TBAppNameInTitleBar], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                    </StackPanel>

                                    <!-- Status bar -->
                                    <TextBlock Text="{Binding [TBStatusBar], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                               FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" x:Name="ShowStatusBarCheck" Content="{Binding [HistoryShowLabel], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                  Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        <Slider Grid.Column="1" x:Name="StatusBarHeightSlider"
                                                Minimum="24" Maximum="60" TickFrequency="1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="StatusBarHeight_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="StatusBarHeightLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ShowStatusWifiCheck" Content="{Binding [TBShowWifiName], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                  Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                        <CheckBox x:Name="ShowStatusTunnelCheck" Content="{Binding [TBShowTunnelName], Source={x:Static local:Lang.Instance}}"
                                                  FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- ── Assets ─────────────────────────────────────── -->
                            <!-- Every image asset is always dark/light sensitive: two independent
                                 pickers per asset (Light + Dark), each falling back to the other
                                 variant's / a legacy shared value only until you pick one explicitly. -->
                            <TextBlock Text="{Binding [TBSecAssets], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Logo -->
                                    <TextBlock Text="{Binding [TBAssetLogo], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="LogoLightPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseLogoLight_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearLogoLight_Click"/>
                                        <Border Grid.Column="4" x:Name="LogoPreviewBorderLight" Margin="8,0,0,0"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                                            <Image x:Name="LogoPreviewImgLight" Width="24" Height="24"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="LogoDarkPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseLogoDark_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearLogoDark_Click"/>
                                        <Border Grid.Column="4" x:Name="LogoPreviewBorderDark" Margin="8,0,0,0"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                                            <Image x:Name="LogoPreviewImgDark" Width="24" Height="24"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding [TBWidth], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="LogoWidthBox" Width="46"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                 Padding="4,3" TextChanged="Field_Changed"/>
                                        <TextBlock Text="{Binding [TBHeight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="12,0,6,0"/>
                                        <TextBox x:Name="LogoHeightBox" Width="46"
                                                 FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                 Padding="4,3" TextChanged="Field_Changed"/>
                                    </StackPanel>

                                    <!-- App icon -->
                                    <TextBlock Text="{Binding [TBAssetAppIcon], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AppIconLightPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseIconLight_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearIconLight_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AppIconDarkPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseIconDark_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearIconDark_Click"/>
                                    </Grid>

                                    <!-- Tray icon: connected state -->
                                    <TextBlock Text="{Binding [TBAssetTrayConnected], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TrayIconConnLightBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseTrayConnLight_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearTrayConnLight_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TrayIconConnDarkBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseTrayConnDark_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearTrayConnDark_Click"/>
                                    </Grid>

                                    <!-- Tray icon: disconnected state -->
                                    <TextBlock Text="{Binding [TBAssetTrayDisconnected], Source={x:Static local:Lang.Instance}}"
                                               FontFamily="{DynamicResource Theme.FontFamily}" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TrayIconDiscLightBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseTrayDiscLight_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearTrayDiscLight_Click"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TrayIconDiscDarkBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseTrayDiscDark_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearTrayDiscDark_Click"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── Background image ───────────────────────────── -->
                            <TextBlock Text="{Binding [TBSecBackground], Source={x:Static local:Lang.Instance}}" Style="{StaticResource SettingsSectionHeader}"/>
                            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,16">
                                <StackPanel>

                                    <!-- Light path row -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeLight], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BgImageLightPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseBgLight_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearBgLight_Click"/>
                                    </Grid>

                                    <!-- Dark path row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [WizardThemeDark], Source={x:Static local:Lang.Instance}}" FontFamily="{DynamicResource Theme.FontFamily}"
                                                   FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BgImageDarkPathBox"
                                                 FontFamily="Consolas" FontSize="10"
                                                 Padding="6,4" TextChanged="Field_Changed"/>
                                        <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="6,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="BrowseBgDark_Click"/>
                                        <Button Grid.Column="3" Content="{Binding [TBClear], Source={x:Static local:Lang.Instance}}" FontSize="10" Padding="8,4"
                                                Margin="4,0,0,0" Style="{StaticResource FlatBtn}"
                                                Click="ClearBgDark_Click"/>
                                    </Grid>

                                    <!-- Stretch mode (shared — layout, not per-variant) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding [TBStretch], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="StretchFill"    Content="{Binding [TBFill], Source={x:Static local:Lang.Instance}}"    GroupName="BgStretch" Tag="stretch"
                                                     Style="{StaticResource PillRadio}" Checked="BgStretch_Changed"/>
                                        <RadioButton x:Name="StretchCenter"  Content="{Binding [TBCenter], Source={x:Static local:Lang.Instance}}"  GroupName="BgStretch" Tag="center"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="BgStretch_Changed"/>
                                        <RadioButton x:Name="StretchTile"    Content="{Binding [TBTile], Source={x:Static local:Lang.Instance}}"    GroupName="BgStretch" Tag="tile"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="BgStretch_Changed"/>
                                        <RadioButton x:Name="StretchTopLeft" Content="{Binding [TBTopLeft], Source={x:Static local:Lang.Instance}}" GroupName="BgStretch" Tag="topLeft"
                                                     Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="BgStretch_Changed"/>
                                    </StackPanel>

                                    <!-- Opacity -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding [TBOpacity], Source={x:Static local:Lang.Instance}}"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="BgOpacitySlider"
                                                Minimum="0.0" Maximum="1.0" SmallChange="0.01"
                                                VerticalAlignment="Center"
                                                ValueChanged="BgOpacity_Changed"/>
                                        <TextBlock Grid.Column="2" x:Name="BgOpacityLabel"
                                                   FontFamily="{DynamicResource Theme.FontFamily}" FontSize="10"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Footer ── -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}"
                    CornerRadius="{DynamicResource Theme.CornerRadiusBottom}">
                <Grid Margin="12,0">
                    <!-- Undo / redo (left) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="UndoBtn" Content="↶"
                                Style="{StaticResource FlatBtn}" Padding="10,4"
                                IsEnabled="False"
                                ToolTip="{Binding [TBUndoTip], Source={x:Static local:Lang.Instance}}" Click="Undo_Click"/>
                        <Button x:Name="RedoBtn" Content="↷"
                                Style="{StaticResource FlatBtn}" Padding="10,4"
                                Margin="6,0,0,0" IsEnabled="False"
                                ToolTip="{Binding [TBRedoTip], Source={x:Static local:Lang.Instance}}" Click="Redo_Click"/>
                    </StackPanel>

                    <!-- Right: live indicator + status + cancel + save -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LiveIndicator" Text="● LIVE"
                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="Collapsed" Cursor="Hand"
                                   MouseLeftButtonUp="LiveIndicator_Click"
                                   ToolTip="{Binding [TBLiveTip], Source={x:Static local:Lang.Instance}}"/>
                        <TextBlock x:Name="StatusLabel"
                                   FontFamily="{DynamicResource Theme.FontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Success}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="CancelBtn" Content="{Binding [BtnCancel], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource FlatBtn}" Padding="14,6"
                                Margin="0,0,6,0" IsEnabled="False"
                                ToolTip="{Binding [TBCancelTip], Source={x:Static local:Lang.Instance}}"
                                Click="Cancel_Click"/>
                        <Button x:Name="SaveBtn" Content="{Binding [BtnSave], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource SuccessBtn}" Padding="18,6"
                                IsEnabled="False"
                                Click="Save_Click"/>
                        <Button x:Name="CloseBtn" Content="{Binding [BtnClose], Source={x:Static local:Lang.Instance}}"
                                Style="{StaticResource FlatBtn}" Padding="14,6"
                                Margin="6,0,0,0"
                                ToolTip="{Binding [TBCloseTip], Source={x:Static local:Lang.Instance}}"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
