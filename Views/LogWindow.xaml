<Window x:Class="MasselGUARD.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        Title="{Binding [ActivityLogHeader], Source={x:Static local:Lang.Instance}}"
        Width="900" Height="620" MinWidth="480" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        Opacity="{DynamicResource Theme.WindowOpacity}"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="{DynamicResource Theme.CornerRadius}">
        <Grid Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag to move) -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource Surface}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hamburger glyph (matches the activity-log icon) -->
                <Viewbox Grid.Column="0" Width="14" Height="14" Margin="14,0,8,0" VerticalAlignment="Center" Opacity="0.7">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{DynamicResource TextMuted}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 6 H20 M4 12 H20 M4 18 H20"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="{Binding [ActivityLogHeader], Source={x:Static local:Lang.Instance}}"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Border Grid.Column="2" CornerRadius="8" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource C.Accent}" Opacity="0.18"/>
                    </Border.Background>
                    <TextBlock x:Name="CountLabel" Text="0"
                               FontSize="{DynamicResource Theme.FontSize.Tiny}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource ChromeBtn}" Padding="14,0"
                        VerticalAlignment="Stretch" Click="Close_Click"
                        ToolTip="{Binding [BtnClose], Source={x:Static local:Lang.Instance}}">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3 3 L15 15 M15 3 L3 15"/>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Log content -->
            <Border Grid.Row="1" Margin="12,10,12,6"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.CornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column header bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                            CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                        <Grid Margin="10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding [LogColTime], Source={x:Static local:Lang.Instance}}"
                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding [LogColEvent], Source={x:Static local:Lang.Instance}}"
                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource TextMuted}"/>
                        </Grid>
                    </Border>

                    <RichTextBox Grid.Row="1" x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextMuted}"
                                 FontFamily="{DynamicResource Theme.FontFamily}"
                                 FontSize="{DynamicResource Theme.FontSize.Small}"
                                 BorderThickness="0" IsReadOnly="True"
                                 Padding="10,8"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <FlowDocument x:Name="LogDocument"/>
                    </RichTextBox>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,12">
                <Button Content="{Binding [BtnClearLog], Source={x:Static local:Lang.Instance}}"
                        Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Small}"
                        Padding="12,4" Margin="0,0,6,0" Click="Clear_Click"/>
                <Button Content="{Binding [BtnExportLog], Source={x:Static local:Lang.Instance}}"
                        Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Small}"
                        Padding="12,4" Click="Export_Click"/>
                <Button Content="{Binding [BtnClose], Source={x:Static local:Lang.Instance}}"
                        Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Small}"
                        Padding="12,4" Margin="6,0,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
