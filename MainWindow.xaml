<Window x:Class="MasselGUARD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasselGUARD"
        xmlns:views="clr-namespace:MasselGUARD.Views"
        Title="{Binding [AppTitle], Source={x:Static local:Lang.Instance}}"
        Height="660" Width="1200"
        MinHeight="540" MinWidth="980"
        Background="{DynamicResource WindowBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        Opacity="{DynamicResource Theme.WindowOpacity}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <local:PixelGridLengthConverter x:Key="PixelGL"/>
        <!-- Proxy carries the window DataContext into ColumnDefinition bindings inside DataTemplates -->
        <local:BindingProxy x:Key="ColProxy" Data="{Binding}"/>
    </Window.Resources>

    <Border x:Name="OuterBorder" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <!-- Optional background image layer -->
            <Border CornerRadius="0"
                    Visibility="{DynamicResource Theme.HasBackground}">
                <Border.Background>
                    <DynamicResourceExtension ResourceKey="Theme.BackgroundBrush"/>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource Theme.TitleBarHeight}"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="InfoSectionRow" Height="Auto"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ── Title bar ──────────────────────────────────────────── -->
                <Border Grid.Row="0" Background="{DynamicResource Surface}"
                        CornerRadius="0"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">

                            <!-- Icon group: ShowTitleBarIcon=false hides all variants -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{DynamicResource Theme.ShowTitleBarIcon}">

                                <!-- Custom logo (theme override) -->
                                <Image x:Name="TitleLogo"
                                       Source="{DynamicResource Theme.Logo}"
                                       Width="{DynamicResource Theme.LogoWidth}"
                                       Height="{DynamicResource Theme.LogoHeight}"
                                       Visibility="{DynamicResource Theme.HasLogo}"
                                       Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Built-in shield icon (shown when no logo set) -->
                                <Viewbox Width="22" Height="24" Margin="0,0,10,0" Stretch="Uniform"
                                         Visibility="{DynamicResource Theme.HasBuiltinIcon}">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1.2">
                                            <Path.Data>M12,1 L22,5 L22,13 C22,18.5 17.5,22.5 12,24 C6.5,22.5 2,18.5 2,13 L2,5 Z</Path.Data>
                                        </Path>
                                        <Polyline Points="7,9 12,15 17,9"
                                                  Stroke="{DynamicResource ShieldChevronBrush}" StrokeThickness="2.2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </StackPanel>

                            <!-- App name from theme -->
                            <TextBlock Text="{DynamicResource Theme.AppName}"
                                       FontFamily="{DynamicResource Theme.HeaderFontFamily}"
                                       FontSize="{DynamicResource Theme.FontSize.Header}" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center"
                                       Visibility="{DynamicResource Theme.ShowTitleBarAppName}"/>

                        </StackPanel>

                        <!-- Window controls: update badge | settings | minimize / maximize / close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch">
                            <!-- Update available badge — hidden until a newer version is found -->
                            <Button x:Name="UpdateAvailableBtn"
                                    FontSize="14" FontWeight="Bold" Padding="10,0"
                                    Style="{StaticResource ChromeBtn}"
                                    Foreground="{DynamicResource Accent}"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Click="UpdateAvailableBtn_Click">
                                <Button.Content>
                                    <TextBlock Text="↑" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}"/>
                                </Button.Content>
                            </Button>
                            <Rectangle x:Name="UpdateAvailableSep"
                                       Width="1" Height="16" VerticalAlignment="Center"
                                       Margin="0,0,4,0" Fill="{DynamicResource BorderColor}"
                                       Visibility="Collapsed"/>
                            <!-- Settings -->
                            <Button Padding="12,0"
                                    Style="{StaticResource ChromeBtn}"
                                    VerticalAlignment="Stretch"
                                    Click="SettingsBtn_Click"
                                    ToolTip="{Binding [TooltipSettings], Source={x:Static local:Lang.Instance}}">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M19.14,12.94a7.49,7.49 0 0 0 0-1.88l2.03-1.58a0.5,0.5 0 0 0 0.12-0.64l-1.92-3.32a0.5 0.5 0 0 0-0.61-0.22l-2.39,0.96a7 7 0 0 0-1.62-0.94l-0.36-2.54a0.5 0.5 0 0 0-0.5-0.42h-3.84a0.5 0.5 0 0 0-0.5 0.42l-0.36 2.54a7 7 0 0 0-1.62 0.94l-2.39-0.96a0.5 0.5 0 0 0-0.61 0.22L2.68 8.84a0.5 0.5 0 0 0 0.12 0.64l2.03 1.58a7.49 7.49 0 0 0 0 1.88l-2.03 1.58a0.5 0.5 0 0 0-0.12 0.64l1.92 3.32a0.5 0.5 0 0 0 0.61 0.22l2.39-0.96a7 7 0 0 0 1.62 0.94l0.36 2.54a0.5 0.5 0 0 0 0.5 0.42h3.84a0.5 0.5 0 0 0 0.5-0.42l0.36-2.54a7 7 0 0 0 1.62-0.94l2.39 0.96a0.5 0.5 0 0 0 0.61-0.22l1.92-3.32a0.5 0.5 0 0 0-0.12-0.64ZM12 15.6A3.6 3.6 0 1 1 15.6 12 3.6 3.6 0 0 1 12 15.6Z"/>
                                </Viewbox>
                            </Button>
                            <!-- Separator -->
                            <Rectangle Width="1" Height="16" VerticalAlignment="Center"
                                       Margin="4,0" Fill="{DynamicResource BorderColor}"/>
                            <!-- Chrome — all at the same visual size -->
                            <Button Content="─" FontSize="14" Padding="12,0"
                                    Style="{StaticResource ChromeBtn}"
                                    VerticalAlignment="Stretch"
                                    Click="MinimizeBtn_Click"
                                    ToolTip="Minimize"/>
                            <Button x:Name="MaximizeBtn"
                                    Content="□" FontSize="13" Padding="12,0"
                                    Style="{StaticResource ChromeBtn}"
                                    VerticalAlignment="Stretch"
                                    Click="MaximizeBtn_Click"
                                    ToolTip="Maximize"/>
                            <Button Content="✕" FontSize="11" Padding="12,0"
                                    Style="{StaticResource ChromeCloseBtn}"
                                    VerticalAlignment="Stretch"
                                    Click="CloseBtn_Click"
                                    ToolTip="Close to tray"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Status bar — removed; row height = 0; elements kept for code compat ── -->
                <Border Grid.Row="1" Visibility="Collapsed">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding [StatusWifi], Source={x:Static local:Lang.Instance}}"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{DynamicResource Theme.ShowStatusWifi}"
                                   ToolTip="Current WiFi network"
                                   ToolTipService.InitialShowDelay="800"/>
                        <TextBlock Grid.Column="1" x:Name="WifiLabel"
                                   Text="{Binding [StatusScanning], Source={x:Static local:Lang.Instance}}"
                                   FontSize="11" FontWeight="Bold" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{DynamicResource Theme.ShowStatusWifi}"
                                   ToolTip="Click to see WiFi rules for this network"
                                   ToolTipService.InitialShowDelay="800"/>

                        <!-- Active tunnel label removed; TunnelLabel kept hidden for code compat -->
                        <TextBlock Grid.Column="4" x:Name="TunnelLabel"
                                   Visibility="Collapsed"/>


                        <StackPanel Grid.Column="6" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <Button x:Name="QuickConnectBtn"
                                    Content="{Binding [BtnQuickConnect], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="10" Padding="10,3"
                                    Visibility="Collapsed"
                                    ToolTip="{Binding [TooltipQuickConnect], Source={x:Static local:Lang.Instance}}"
                                    Click="QuickConnect_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Rectangle Grid.Row="2" Fill="{DynamicResource BorderColor}"/>

                <!-- ── Error banner (hidden by default) ── -->
                <Border Grid.Row="3" x:Name="ErrorBanner"
                        Background="{DynamicResource ErrorBg}" BorderBrush="{DynamicResource ErrorColor}" BorderThickness="0,0,0,1"
                        Padding="14,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ErrorBannerText" Grid.Column="0"
                                   FontSize="{DynamicResource Theme.FontSize.Small}" Foreground="{DynamicResource ErrorColor}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource DangerBtn}"
                                FontSize="11" Padding="8,2" Margin="12,0,0,0"
                                BorderThickness="0" Background="Transparent"
                                Click="DismissBanner_Click"/>
                    </Grid>
                </Border>

                <!-- ── Main content ─────────────────────────────────────────── -->
                <Grid Grid.Row="4" x:Name="MainContentGrid" Margin="14,12,14,8"
                      Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="10"/>         <!-- gap — collapses when log hidden -->
                        <ColumnDefinition Width="*"/>          <!-- log panel — collapses when log hidden -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow"/>
                        <RowDefinition Height="3*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="WifiRulesHeaderRow" Height="Auto"/>
                        <RowDefinition x:Name="WifiRulesPanelRow"  Height="2*" MinHeight="152"/>
                        <RowDefinition x:Name="WifiRulesBtnsRow"   Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LEFT: Tunnels only -->

                        <!-- Header row: TUNNELS label + category tabs (left) | ☰ log-open button (right) -->
                        <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,0,6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding [SectionTunnels], Source={x:Static local:Lang.Instance}}"
                                           Style="{StaticResource SectionLabel}" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <!-- Tunnel count / hidden-override badge — sits right after the label -->
                                <Border x:Name="HiddenCountBadge"
                                        Background="{DynamicResource BorderColor}"
                                        CornerRadius="8" Padding="6,1" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Button x:Name="HiddenCountBtn"
                                            Style="{StaticResource FlatBtn}"
                                            FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="HiddenCountBtn_Click"/>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent"
                                              VerticalAlignment="Center">
                                    <StackPanel x:Name="TunnelTabButtons"
                                                Orientation="Horizontal"
                                                Background="Transparent"/>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- ☰ — shown only when the log panel is collapsed -->
                            <Button x:Name="LogOpenBtn"
                                    Grid.Column="1"
                                    Content="☰" FontSize="11" Padding="6,2"
                                    Style="{StaticResource FlatBtn}"
                                    Foreground="{DynamicResource TextMuted}"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Click="LogToggle_Click"
                                    ToolTip="Show activity log"/>
                        </Grid>

                        <!-- Tunnel box -->
                        <Border Grid.Column="0" Grid.Row="1"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.CornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Column header bar -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                                    <Grid x:Name="TunnelColGrid" Margin="8,5"
                                          LayoutUpdated="TunnelColGrid_LayoutUpdated"
                                          SizeChanged="TunnelColGrid_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="TunColDef0" Width="3*"   MinWidth="60"/>
                                            <ColumnDefinition x:Name="TunColDef1" Width="3.2*" MinWidth="60"/>
                                            <ColumnDefinition x:Name="TunColDef2" Width="50"   MinWidth="30"/>
                                            <ColumnDefinition x:Name="TunColDef3" Width="1.5*" MinWidth="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SortHeaderBtn}" Click="TunSort_Name">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [TunnelColName], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="TunArrowName" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="1" Style="{StaticResource SortHeaderBtn}" Click="TunSort_Status">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [TunnelColStatus], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="TunArrowStatus" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Right"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="2" x:Name="RulesColHeader"
                                                Style="{StaticResource SortHeaderBtn}" Click="TunSort_Rules"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Visibility="{Binding DataContext.RulesColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [TunnelColRules], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="TunArrowRules" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Drag handle: left edge of Action — resizes Rules vs Action -->
                                        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Left"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="3" Style="{StaticResource SortHeaderBtn}" Click="TunSort_Action" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [TunnelColAction], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="TunArrowAction" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tunnel rows -->
                                <ListView Grid.Row="1" x:Name="TunnelsListView"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="TunnelsListView_SelectionChanged"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          AllowDrop="True"
                                          PreviewMouseMove="TunnelList_PreviewMouseMove"
                                          Drop="TunnelList_Drop"
                                          DragOver="TunnelList_DragOver">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,1"/>
                                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                                         Handler="TunnelItem_MouseDown"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding [MenuShowQr], Source={x:Static local:Lang.Instance}}"
                                                                  Click="ShowQr_Click"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Data-cap breach highlight (subtle amber row tint) -->
                                                <Border Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="{Binding CapHighlightBrush}"
                                                        Opacity="0.15" CornerRadius="3"
                                                        Visibility="{Binding CapHighlightVisibility}"/>
                                                <!-- Group colour strip -->
                                                <Rectangle Grid.Column="0"
                                                           Fill="{Binding GroupAccentBrush}"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="2,3,2,3"/>
                                                <!-- Row content -->
                                                <Grid Grid.Column="1" Margin="4,3,8,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Data.TunCol0W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="60"/>
                                                        <ColumnDefinition Width="{Binding Data.TunCol1W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="60"/>
                                                        <ColumnDefinition Width="{Binding Data.TunCol2W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="30"/>
                                                        <ColumnDefinition Width="{Binding Data.TunCol3W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Name + badges -->
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{Binding NameColor}"
                                                                   TextDecorations="{Binding NameDecoration}"
                                                                   FontSize="{DynamicResource Theme.FontSize}"
                                                                   ToolTip="{Binding Notes}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text=" ⚡"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Default action tunnel"
                                                                   Visibility="{Binding DefaultBadgeVis}"/>
                                                        <TextBlock Text=" 🔓"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Open network protection tunnel"
                                                                   Visibility="{Binding OpenBadgeVis}"/>
                                                    </StackPanel>
                                                    <!-- Status  |  ↑↓ traffic  |  DNS leak (left) · usage rings (pinned right) -->
                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <!-- Status dot — colour reflects health/traffic when active
                                                             (green healthy · amber idle · red down) -->
                                                        <TextBlock Text="{Binding StatusDot}"
                                                                   Foreground="{Binding StatusDotColor}"
                                                                   FontSize="{DynamicResource Theme.FontSize}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"
                                                                   ToolTip="{Binding HealthTooltip}"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{Binding StatusColor}"
                                                                   FontSize="{DynamicResource Theme.FontSize}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="  |  "
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DnsLeakVisibility}"/>
                                                        <TextBlock Text="{Binding DnsLeakDisplay}"
                                                                   Foreground="{Binding DnsLeakColor}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding DnsLeakVisibility}"
                                                                   ToolTip="{Binding DnsLeakTooltip}"/>
                                                    </StackPanel>
                                                        <!-- Data-cap usage rings — day · week · month, each drawn only when its cap
                                                             is set (d/w/m centre glyph). Pinned in its own right-hand Grid cell with a
                                                             fixed left gap, so the growing uptime text never shifts it. Hover = breakdown. -->
                                                        <views:CapRings Grid.Column="1"
                                                                        Margin="14,0,2,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding CapRingsVisibility}"
                                                                        Active="{Binding IsActive}"
                                                                        DayFraction="{Binding DayCapFraction}"
                                                                        WeekFraction="{Binding WeekCapFraction}"
                                                                        MonthFraction="{Binding MonthCapFraction}"
                                                                        DaySet="{Binding DayCapSet}"
                                                                        WeekSet="{Binding WeekCapSet}"
                                                                        MonthSet="{Binding MonthCapSet}"
                                                                        ToolTip="{Binding CapRingsTooltip}"
                                                                        ToolTipService.InitialShowDelay="0"
                                                                        ToolTipService.BetweenShowDelay="0"/>
                                                    </Grid>
                                                    <!-- Rules hit count -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding RuleCount}"
                                                               Foreground="{Binding RuleCountColor}"
                                                               TextDecorations="{Binding RuleCountDecoration}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Cursor="Hand"
                                                               Padding="4,0"
                                                               ToolTip="{Binding RuleCountTooltip}"
                                                               Visibility="{Binding DataContext.RulesColumnVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               MouseLeftButtonDown="RuleCount_Click"/>
                                                    <!-- Connect / Disconnect button + cap-kill marker -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <Button Content="{Binding ButtonLabel}"
                                                                IsEnabled="{Binding ButtonEnabled}"
                                                                ToolTip="{Binding ButtonTooltip}"
                                                                Click="TunnelToggle_Click"
                                                                Padding="6,2"
                                                                FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                Style="{StaticResource FlatBtn}"/>
                                                        <TextBlock Text="🛑"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="5,0,0,0"
                                                                   Visibility="{Binding CapKilledVisibility}"
                                                                   ToolTip="{Binding CapKilledTooltip}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Tunnel management buttons -->
                        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{Binding [BtnAddTunnel], Source={x:Static local:Lang.Instance}}"
                                    x:Name="AddTunnelBtn"
                                    Style="{StaticResource SuccessBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Click="AddTunnel_Click"/>
                            <Button Content="{Binding [BtnEditTunnel], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" x:Name="EditTunnelBtn" IsEnabled="False"
                                    Click="EditTunnel_Click"/>
                            <Button Content="{Binding [BtnImportTunnel], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0"
                                    Click="ImportTunnel_Click"/>
                            <Button Content="{Binding [BtnDefaults], Source={x:Static local:Lang.Instance}}"
                                    x:Name="DefaultsBtn"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0"
                                    Click="DefaultsBtn_Click"/>
                            <Button Content="{Binding [BtnExportTunnel], Source={x:Static local:Lang.Instance}}"
                                    x:Name="ExportTunnelBtn"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" IsEnabled="False"
                                    Click="ExportTunnel_Click"/>
                            <Button x:Name="DeleteTunnelBtn"
                                    Style="{StaticResource DangerBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" IsEnabled="False" Visibility="Collapsed"
                                    Click="DeleteTunnel_Click"/>
                        </StackPanel>

                        <!-- WIFI RULES section — row 3 header, row 4 content -->
                        <StackPanel Grid.Column="0" Grid.Row="3"
                                    x:Name="WifiRulesHeader"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding [SectionWifiRules], Source={x:Static local:Lang.Instance}}"
                                       Style="{StaticResource SectionLabel}" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="8" Padding="6,1"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource C.Accent}" Opacity="0.18"/>
                                </Border.Background>
                                <TextBlock x:Name="WifiRuleCountLabel"
                                           FontSize="{DynamicResource Theme.FontSize.Tiny}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" Text="0"/>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="0" Grid.Row="4"
                                x:Name="WifiRulesPanel"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.CornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Column header bar -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                                    <Grid x:Name="WifiColGrid" Margin="8,5"
                                          LayoutUpdated="WifiColGrid_LayoutUpdated"
                                          SizeChanged="WifiColGrid_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="WifColDef0" Width="3*"   MinWidth="50"/>
                                            <ColumnDefinition x:Name="WifColDef1" Width="2*"   MinWidth="50"/>
                                            <ColumnDefinition x:Name="WifColDef2" Width="1.5*" MinWidth="50"/>
                                            <ColumnDefinition x:Name="WifColDef3" Width="40"   MinWidth="30"/>
                                            <ColumnDefinition x:Name="WifColDef4" Width="2*"   MinWidth="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SortHeaderBtn}" Click="RuleSort_Name">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [RuleColName], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="RuleArrowName" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="1" Style="{StaticResource SortHeaderBtn}" Click="RuleSort_Ssid">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [RuleColSsid], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="RuleArrowSsid" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Right"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="2" Style="{StaticResource SortHeaderBtn}" Click="RuleSort_Action">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [RuleColAction], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="RuleArrowAction" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Right"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="3" Style="{StaticResource SortHeaderBtn}" Click="RuleSort_Count" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [RuleColCount], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="RuleArrowCount" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Drag handle: left edge of Tunnel — resizes Count vs Tunnel -->
                                        <GridSplitter Grid.Column="4" Width="5" HorizontalAlignment="Left"
                                                      Background="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                                                      PreviewMouseLeftButtonUp="ColSplitter_MouseUp"/>
                                        <Button Grid.Column="4" Style="{StaticResource SortHeaderBtn}" Click="RuleSort_Tunnel">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [RuleColTunnel], Source={x:Static local:Lang.Instance}}" FontSize="{DynamicResource Theme.FontSize.Tiny}"/>
                                                <TextBlock x:Name="RuleArrowTunnel" Text="" FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource Accent}" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Rule rows -->
                                <ListView Grid.Row="1" x:Name="WifiRulesListView"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          IsHitTestVisible="True"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="WifiRule_PreviewMouseDown"
                                          PreviewMouseMove="WifiRule_PreviewMouseMove"
                                          Drop="WifiRule_Drop"
                                          SelectionChanged="WifiRulesListView_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background"               Value="Transparent"/>
                                            <Setter Property="BorderThickness"          Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding"                  Value="0"/>
                                            <Setter Property="Margin"                   Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ListSelected}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBg}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="{Binding BorderThick}">
                                                <Grid Margin="8,3" Opacity="{Binding Rule.RowOpacity}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding Data.WifCol0W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="60"/>
                                                        <ColumnDefinition Width="{Binding Data.WifCol1W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="50"/>
                                                        <ColumnDefinition Width="{Binding Data.WifCol2W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="50"/>
                                                        <ColumnDefinition Width="{Binding Data.WifCol3W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="30"/>
                                                        <ColumnDefinition Width="{Binding Data.WifCol4W, Source={StaticResource ColProxy}, Converter={StaticResource PixelGL}}" MinWidth="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Rule.DisabledIcon}"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="{DynamicResource Theme.FontSize.Small}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RuleName}"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="{DynamicResource Theme.FontSize}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Ssid}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ActionLabel}"
                                                               Foreground="{Binding ActionColor}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding ExecutionCountText}"
                                                               Foreground="{Binding ExecutionCountColor}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding TunnelName}"
                                                               Foreground="{Binding TunnelFg}"
                                                               FontWeight="{Binding TunnelFontWeight}"
                                                               FontSize="{DynamicResource Theme.FontSize.Small}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- WiFi Rules edit buttons — outside the box, same level as tunnel buttons -->
                        <StackPanel Grid.Column="0" Grid.Row="5"
                                    Orientation="Horizontal" Margin="0,6,0,0"
                                    x:Name="WifiRuleButtonsPanel">
                            <Button x:Name="WifiRuleAddBtn"
                                    Content="{Binding [BtnAddRule], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Click="WifiRuleAdd_Click"/>
                            <Button x:Name="WifiRuleEditBtn"
                                    Content="{Binding [BtnEditRule], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" IsEnabled="False"
                                    Click="WifiRuleEdit_Click"/>
                            <Button x:Name="WifiRuleDeleteBtn"
                                    Content="{Binding [BtnDeleteRule], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource DangerBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" IsEnabled="False"
                                    Click="WifiRuleDelete_Click"/>
                            <Button x:Name="WifiRuleToggleBtn"
                                    Content="{Binding [BtnDisableRule], Source={x:Static local:Lang.Instance}}"
                                    Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                    Margin="6,0,0,0" IsEnabled="False"
                                    Click="WifiRuleToggle_Click"/>
                        </StackPanel>

                    <!-- RIGHT: Activity Log — self-contained, spans all left rows -->
                        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="6" x:Name="LogPanelGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="HeaderRow"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ACTIVITY LOG header -->
                            <Grid Grid.Row="0" Margin="0,0,0,6" MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding [ActivityLogHeader], Source={x:Static local:Lang.Instance}}"
                                           Style="{StaticResource SectionLabel}" Margin="0"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource C.Accent}" Opacity="0.18"/>
                                    </Border.Background>
                                    <TextBlock x:Name="LogCountLabel"
                                               FontSize="{DynamicResource Theme.FontSize.Tiny}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" Text="0"/>
                                </Border>
                                <!-- Collapse button — collapses with the log panel -->
                                <Button Grid.Column="3"
                                        Content="»" FontSize="22" Padding="4,0"
                                        Style="{StaticResource FlatBtn}"
                                        Foreground="{DynamicResource TextMuted}"
                                        VerticalAlignment="Center"
                                        Click="LogToggle_Click"
                                        ToolTip="Hide activity log"/>
                            </Grid>

                            <!-- Log content -->
                            <Border Grid.Row="1" x:Name="LogContent"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.CornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Column header bar -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                                        <Grid Margin="8,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding [LogColTime], Source={x:Static local:Lang.Instance}}"
                                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding [LogColEvent], Source={x:Static local:Lang.Instance}}"
                                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Log entries -->
                                    <RichTextBox Grid.Row="1" x:Name="LogBox"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 FontFamily="{DynamicResource Theme.FontFamily}"
                                                 FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                 BorderThickness="0" IsReadOnly="True"
                                                 Padding="8,6"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled">
                                        <FlowDocument x:Name="LogDocument"/>
                                    </RichTextBox>
                                </Grid>
                            </Border>

                            <!-- Clear / Export buttons -->
                            <StackPanel x:Name="LogExportRow" Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{Binding [BtnClearLog], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                        Margin="0,0,6,0"
                                        Click="ClearLog_Click"/>
                                <Button Content="{Binding [BtnExportLog], Source={x:Static local:Lang.Instance}}"
                                        Style="{StaticResource FlatBtn}" FontSize="{DynamicResource Theme.FontSize.Tiny}" Padding="10,3"
                                        Click="ExportLog_Click"/>
                            </StackPanel>
                        </Grid>

                </Grid>

                <!-- ── Timeline (Connection History) ─────────────────────── -->
                <Border Grid.Row="5" x:Name="InfoSectionBorder"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <Grid Margin="14,6,14,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- chart card with TIMELINE header -->
                            <RowDefinition Height="5"/>    <!-- gap -->
                            <RowDefinition Height="18"/>   <!-- legend -->
                        </Grid.RowDefinitions>

                        <!-- Chart card — TIMELINE header bar + canvases -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.CornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- TIMELINE header bar -->
                                    <RowDefinition Height="Auto"/> <!-- chart canvases -->
                                </Grid.RowDefinitions>

                                <!-- TIMELINE header bar — label left, range toggles right -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{DynamicResource Theme.CornerRadiusTop}">
                                    <Grid Margin="8,5">
                                        <!-- View switch: Timeline ⇄ Data usage -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="ModeTimelineBtn" GroupName="InfoPanelMode"
                                                         IsChecked="True" Margin="0,0,12,0"
                                                         VerticalAlignment="Center" Checked="InfoMode_Changed">
                                                <RadioButton.Style><Style TargetType="RadioButton"><Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <TextBlock x:Name="tb" Text="TIMELINE" FontSize="{DynamicResource Theme.FontSize.Tiny}" FontFamily="{DynamicResource Theme.FontFamily}" Foreground="{DynamicResource TextMuted}" Cursor="Hand" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tb" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter></Style></RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeUsageBtn" GroupName="InfoPanelMode"
                                                         VerticalAlignment="Center" Checked="InfoMode_Changed">
                                                <RadioButton.Style><Style TargetType="RadioButton"><Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <TextBlock x:Name="tb" Text="DATA USAGE" FontSize="{DynamicResource Theme.FontSize.Tiny}" FontFamily="{DynamicResource Theme.FontFamily}" Foreground="{DynamicResource TextMuted}" Cursor="Hand" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tb" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter></Style></RadioButton.Style>
                                            </RadioButton>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <!-- Session navigation -->
                                            <TextBlock x:Name="ChartNavLabel" FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button x:Name="ChartPrevBtn" Content="◀" FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                    Padding="4,1" Margin="0,0,2,0"
                                                    Style="{StaticResource FlatBtn}"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    Click="ChartPrev_Click"/>
                                            <Button x:Name="ChartNextBtn" Content="▶" FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                                    Padding="4,1" Margin="0,0,10,0"
                                                    Style="{StaticResource FlatBtn}"
                                                    Foreground="{DynamicResource TextMuted}"
                                                    Click="ChartNext_Click"/>
                                            <!-- Separator -->
                                            <Rectangle Width="1" Height="10" Fill="{DynamicResource BorderColor}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="Range24hBtn" GroupName="InfoTimeRange"
                                                         IsChecked="True" Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Checked="InfoRange_Changed">
                                                <RadioButton.Style><Style TargetType="RadioButton"><Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <TextBlock x:Name="tb" Text="24h" FontSize="{DynamicResource Theme.FontSize.Tiny}" FontFamily="{DynamicResource Theme.FontFamily}" Foreground="{DynamicResource TextMuted}" Cursor="Hand" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tb" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter></Style></RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton x:Name="Range7dBtn" GroupName="InfoTimeRange"
                                                         Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Checked="InfoRange_Changed">
                                                <RadioButton.Style><Style TargetType="RadioButton"><Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <TextBlock x:Name="tb" Text="7d" FontSize="{DynamicResource Theme.FontSize.Tiny}" FontFamily="{DynamicResource Theme.FontFamily}" Foreground="{DynamicResource TextMuted}" Cursor="Hand" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tb" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter></Style></RadioButton.Style>
                                            </RadioButton>
                                            <RadioButton x:Name="Range31dBtn" GroupName="InfoTimeRange"
                                                         VerticalAlignment="Center"
                                                         Checked="InfoRange_Changed">
                                                <RadioButton.Style><Style TargetType="RadioButton"><Setter Property="Template"><Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <TextBlock x:Name="tb" Text="31d" FontSize="{DynamicResource Theme.FontSize.Tiny}" FontFamily="{DynamicResource Theme.FontFamily}" Foreground="{DynamicResource TextMuted}" Cursor="Hand" VerticalAlignment="Center"/>
                                                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="tb" Property="Foreground" Value="{DynamicResource Accent}"/><Setter TargetName="tb" Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value></Setter></Style></RadioButton.Style>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Chart canvases -->
                                <Grid Grid.Row="1" Margin="8,6">
                                    <Canvas x:Name="TimelineCanvas" ClipToBounds="True"
                                            SizeChanged="TimelineCanvas_SizeChanged"
                                            MouseMove="TimelineCanvas_MouseMove"
                                            MouseLeave="TimelineCanvas_MouseLeave"/>
                                    <Canvas x:Name="ChartOverlayCanvas"
                                            IsHitTestVisible="False" Panel.ZIndex="10"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Legend row: tunnel items left, WiFi SSID items right -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tunnel legend with scroll markers -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TunnelScrollLeft" Grid.Column="0" Content="‹" FontSize="9"
                                        Padding="1,0" Style="{StaticResource FlatBtn}"
                                        Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"
                                        Click="TunnelScrollLeft_Click"/>
                                <ScrollViewer x:Name="TunnelLegendScroll" Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              ScrollChanged="LegendScroll_Changed"
                                              PreviewMouseWheel="LegendScroll_Wheel">
                                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <Button x:Name="TunnelScrollRight" Grid.Column="2" Content="›" FontSize="9"
                                        Padding="1,0" Style="{StaticResource FlatBtn}"
                                        Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"
                                        Click="TunnelScrollRight_Click"/>
                            </Grid>

                            <!-- WiFi SSID legend, right-aligned -->
                            <Grid Grid.Column="1" x:Name="WifiLegendContainer" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto" MaxWidth="280"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="WifiScrollLeft" Grid.Column="0" Content="‹" FontSize="9"
                                        Padding="1,0" Style="{StaticResource FlatBtn}"
                                        Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"
                                        Click="WifiScrollLeft_Click"/>
                                <ScrollViewer x:Name="WifiLegendScroll" Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              ScrollChanged="LegendScroll_Changed"
                                              PreviewMouseWheel="LegendScroll_Wheel">
                                    <StackPanel x:Name="WifiLegendPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <Button x:Name="WifiScrollRight" Grid.Column="2" Content="›" FontSize="9"
                                        Padding="1,0" Style="{StaticResource FlatBtn}"
                                        Foreground="{DynamicResource TextMuted}" Visibility="Collapsed"
                                        Click="WifiScrollRight_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Footer ─────────────────────────────────────────────── -->
                <Border Grid.Row="6" Background="{DynamicResource Surface}"
                        CornerRadius="0">
                    <Grid Margin="14,0">
                        <TextBlock x:Name="FooterLabel"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                   VerticalAlignment="Center"/>
                        <!-- Centre: wifi · default action · open protection — truly centred -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="WifiFooterLabel"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       ToolTip="Current WiFi network"
                                       ToolTipService.InitialShowDelay="800"/>
                            <Rectangle x:Name="WifiFooterSep" Width="1" Height="12" Margin="10,0"
                                       Fill="{DynamicResource BorderColor}" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="DefaultTunnelLabel"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       ToolTip="Default action tunnel — activates when no WiFi rule matches"
                                       ToolTipService.InitialShowDelay="800"/>
                            <Rectangle Width="1" Height="12" Margin="10,0"
                                       Fill="{DynamicResource BorderColor}" VerticalAlignment="Center"
                                       x:Name="StatusCentreSep" Visibility="Collapsed"/>
                            <TextBlock x:Name="OpenProtectionLabel"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="{DynamicResource Theme.FontSize.Tiny}" VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       ToolTip="Open network protection — activates automatically on passwordless WiFi"
                                       ToolTipService.InitialShowDelay="800"/>
                        </StackPanel>
                        <TextBlock x:Name="AdminLabel"
                                   HorizontalAlignment="Right" FontSize="{DynamicResource Theme.FontSize.Tiny}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- No custom resize grip: WPF already draws its own for
                     ResizeMode=CanResizeWithGrip (required since AllowsTransparency
                     windows can't be edge-dragged); a second one duplicated it. -->
            </Grid>
        </Grid>
    </Border>
</Window>
