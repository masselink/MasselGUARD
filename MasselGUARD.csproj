<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe (GUI subsystem) — Windows never allocates a console, so there
         is no console flash on launch.  CLI functionality is provided by
         MasselGUARDcli.exe which uses OutputType=Exe. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MasselGUARD</AssemblyName>
    <RootNamespace>MasselGUARD</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>MasselGUARD.Program</StartupObject>
    <!-- Strip all framework satellite resource folders (tr, ru, fr, de, etc.)
         The app uses its own lang/*.json files for localisation — these
         WPF/WinForms satellite assemblies are not needed. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single-file framework-dependent publish — bundles app + NuGet dlls
         into one exe. Runtime is NOT included; .NET 10 Desktop Runtime must
         be installed on the target machine.
         RID is overridable: BUILD.bat passes -p:RuntimeIdentifier=win-arm64
         to produce the native ARM64 build; IDE / bare `dotnet build` default
         to win-x64. Both win-x64 and win-arm64 are supported targets. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>MasselGUARD.ico</ApplicationIcon>
    <!-- Default versions for IDE / dotnet build without BUILD.bat.
         BUILD.bat overrides these via -p:Version / -p:InformationalVersion. -->
    <Version>3.9.0</Version>
    <AssemblyVersion>3.9.0.0</AssemblyVersion>
    <FileVersion>3.9.0.0</FileVersion>
    <InformationalVersion>3.9.0</InformationalVersion>
    <!-- Keep the SDK from appending "+<git-sha>" to InformationalVersion — the
         About page shows the raw value as the build stamp. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.9" />
  </ItemGroup>

  <!-- Exclude sibling sub-projects from THIS project's default globs. Both live under
       the GUI project directory, so the SDK's '**/*.cs' compile glob would otherwise
       pull them in:
         * deps\          — third-party wireguard-windows demo source (never compile).
         * MasselGUARDcli\ — the CLI project. The CLI shares the GUI's source via
           <Compile Include> LINKS (one-way), so the GUI must never compile the CLI's
           own files. Critically this also excludes MasselGUARDcli\obj\, whose generated
           MasselGUARDcli.AssemblyInfo.cs would otherwise be compiled into the GUI and
           collide with the GUI's own assembly attributes (CS0579 "duplicate attribute" —
           it only surfaced once the CLI had been built and its obj\ was populated). -->
  <ItemGroup>
    <Compile Remove="deps\**" />
    <Content Remove="deps\**" />
    <EmbeddedResource Remove="deps\**" />
    <None Remove="deps\**" />
    <Compile Remove="MasselGUARDcli\**" />
    <Content Remove="MasselGUARDcli\**" />
    <EmbeddedResource Remove="MasselGUARDcli\**" />
    <None Remove="MasselGUARDcli\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MasselGUARD.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lang\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lang\flags\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- tunnel.dll + wireguard.dll enable standalone local tunnels.
         tunnel.dll bundles the WireGuardNT kernel driver — no WireGuard for
         Windows installation required on the target machine.
         Build:    tunnel.dll    → wireguard-windows/embeddable-dll-service (Go)
         Download: wireguard.dll → https://download.wireguard.com/wireguard-nt/
         Both are optional; place them next to the exe to enable local tunnels. -->
    <Content Include="tunnel.dll" Condition="Exists('tunnel.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="wireguard.dll" Condition="Exists('wireguard.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
